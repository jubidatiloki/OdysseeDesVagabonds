rules_version = '2';

// Règles de sécurité Firestore — L'odyssée des vagabonds.
// Collection « personnages » : un document par fiche.
//   proprietaire : uid du compte qui l'a créée (seul à pouvoir la modifier)
//   partageAvec  : uids qui peuvent la lire (MJ et joueurs des campagnes)
// Collection « campagnes » : parties à plusieurs menées par un MJ.
//   mj, joueurs, demandes (uids), code, paramètres, séance
//   prive/mj : script et notes (MJ seulement)
//   membres/{uid} : joueur, personnage, statut (demande / accepte)
//   jeu/etat : mode et tours de la séance
//   creatures/{c} : ce que voient les PJ ; creaturesMj/{c} : MJ seulement
//   ressources/{uid} : PV, PM, PE (selon les paramètres de la campagne)
//   jets/{j} : lisibles par leurs seuls « lecteurs »
//   notesJoueurs/{uid}/seances/{n} : le joueur seulement
// Collection « codes » : code d'invitation → campagne.
service cloud.firestore {
  match /databases/{database}/documents {
    function connecte() {
      return request.auth != null;
    }
    function soi() {
      return request.auth.uid;
    }

    match /personnages/{id} {
      function documentValide() {
        let d = request.resource.data;
        return d.proprietaire is string
          && (!('partageAvec' in d) || d.partageAvec is list)
          && d.fiche is string
          && d.fiche.size() < 900000;
      }

      // Lecture : le propriétaire, ou un joueur avec qui la fiche est partagée.
      allow read: if connecte()
        && (resource.data.proprietaire == soi()
            || soi() in resource.data.get('partageAvec', []));

      // Création : seulement à son propre nom.
      allow create: if connecte()
        && request.resource.data.proprietaire == soi()
        && documentValide();

      // Modification : le propriétaire, sans changer de propriétaire.
      allow update: if connecte()
        && resource.data.proprietaire == soi()
        && request.resource.data.proprietaire == soi()
        && documentValide();

      allow delete: if connecte()
        && resource.data.proprietaire == soi();
    }

    match /campagnes/{id} {
      function estMj() {
        return resource.data.mj == soi();
      }
      function changeSeulement(champs) {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(champs);
      }
      function avant(champ) {
        return resource.data.get(champ, []).toSet();
      }
      function apres(champ) {
        return request.resource.data.get(champ, []).toSet();
      }

      // Lecture d'une campagne connue (son id vient d'un code) ; liste :
      // seulement les siennes (MJ, joueur ou demande en attente).
      allow get: if connecte();
      allow list: if connecte()
        && (resource.data.mj == soi()
            || soi() in resource.data.joueurs
            || soi() in resource.data.demandes);

      allow create: if connecte()
        && request.resource.data.mj == soi()
        && request.resource.data.nom is string
        && request.resource.data.joueurs.size() == 0
        && request.resource.data.demandes.size() == 0;

      // MJ : tout, sauf changer de MJ.
      allow update: if connecte() && estMj()
          && request.resource.data.mj == resource.data.mj
        // Joueur : demander à rejoindre (s'ajouter aux demandes, place libre).
        || connecte() && !estMj()
          && changeSeulement(['demandes'])
          && apres('demandes') == avant('demandes').union([soi()].toSet())
          && !(soi() in resource.data.joueurs)
          && resource.data.joueurs.size() < resource.data.joueursMax
        // Joueur : quitter (se retirer des joueurs et des demandes).
        || connecte() && !estMj()
          && changeSeulement(['demandes', 'joueurs'])
          && apres('demandes') == avant('demandes').difference([soi()].toSet())
          && apres('joueurs') == avant('joueurs').difference([soi()].toSet());

      allow delete: if connecte() && estMj();

      function mjDe(campagne) {
        return get(/databases/$(database)/documents/campagnes/$(campagne))
          .data.mj == soi();
      }
      function membreDe(campagne) {
        return soi() in get(/databases/$(database)/documents/campagnes/$(campagne))
          .data.joueurs;
      }

      // Script et notes : le MJ seulement.
      match /prive/{doc} {
        allow read, write: if connecte() && mjDe(id);
      }

      // Membres : le MJ, le joueur lui-même et les autres joueurs acceptés.
      match /membres/{joueur} {
        allow read: if connecte()
          && (joueur == soi() || mjDe(id) || membreDe(id));
        // Demande : le joueur, à son nom, en attente.
        allow create: if connecte() && joueur == soi()
          && request.resource.data.uid == soi()
          && request.resource.data.statut == 'demande';
        // Le joueur : nouvelle demande (autre personnage) ou mise à jour de
        // son résumé, sans se donner le statut « accepte » ; acceptation : MJ.
        allow update: if connecte()
          && (joueur == soi() && request.resource.data.uid == soi()
              && (request.resource.data.statut == 'demande'
                  || request.resource.data.statut == resource.data.statut)
            || mjDe(id));
        allow delete: if connecte() && (joueur == soi() || mjDe(id));
      }

      function parametre(campagne, nom) {
        return get(/databases/$(database)/documents/campagnes/$(campagne))
          .data.parametres[nom] == true;
      }

      // Mode et tours : le MJ ; le joueur dont c'est le tour peut le passer.
      match /jeu/{doc} {
        allow read: if connecte() && (mjDe(id) || membreDe(id));
        allow create, delete: if connecte() && mjDe(id);
        allow update: if connecte()
          && (mjDe(id)
            || membreDe(id)
              && resource.data.ordre[resource.data.index] == soi()
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['index', 'manche']));
      }

      // Créatures : les PJ ne lisent que les cartes non cachées.
      match /creatures/{creature} {
        allow read: if connecte()
          && (mjDe(id) || membreDe(id) && resource.data.cachee == false);
        allow write: if connecte() && mjDe(id);
      }

      // Vrai nom, fiche et PV des créatures : le MJ seulement.
      match /creaturesMj/{creature} {
        allow read, write: if connecte() && mjDe(id);
      }

      // PV, PM, PE : écrits par le joueur, lus selon les paramètres.
      match /ressources/{joueur} {
        allow read: if connecte()
          && (joueur == soi()
            || mjDe(id) && parametre(id, 'fichesVisiblesMj')
            || membreDe(id) && parametre(id, 'fichesVisiblesJoueurs'));
        allow create, update: if connecte() && joueur == soi() && membreDe(id);
        allow delete: if connecte() && mjDe(id);
      }

      // Jets : lus par leurs lecteurs ; le MJ en fait toujours partie.
      match /jets/{jet} {
        allow read: if connecte() && soi() in resource.data.lecteurs;
        allow create: if connecte()
          && request.resource.data.auteur == soi()
          && (mjDe(id) || membreDe(id))
          && get(/databases/$(database)/documents/campagnes/$(id)).data.mj
            in request.resource.data.lecteurs;
        allow delete: if connecte() && mjDe(id);
      }

      // Notes personnelles d'une séance : le joueur seulement.
      match /notesJoueurs/{joueur}/seances/{numero} {
        allow read, write: if connecte() && joueur == soi();
      }
    }

    // Codes d'invitation : lus un par un (jamais listés) ; écrits par le MJ.
    match /codes/{code} {
      allow get: if connecte();
      allow create: if connecte()
        && request.resource.data.mj == soi()
        && get(/databases/$(database)/documents/campagnes/$(request.resource.data.campagne))
          .data.mj == soi();
      allow delete: if connecte() && resource.data.mj == soi();
    }

    // Tout le reste est fermé.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
