        <mxCell id="GnE5Q-5QsUphRtUW_GcG-45" value="&lt;h1 style=&quot;text-align: center&quot;&gt;Actions possibles dans un tour:&lt;/h1&gt;&lt;h1 style=&quot;font-size: 18px&quot;&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;font-weight: 400&quot;&gt;2 actions de mouvements&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-weight: 400&quot;&gt;1 action de mouvement + 1 action&amp;nbsp; (simple)&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-weight: 400&quot;&gt;1 action complexe&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-weight: 400&quot;&gt;1 action gratuite + cas ci-dessus&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/h1&gt;" style="text;html=1;fillColor=#ffe6cc;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=1;shadow=1;strokeColor=#d79b00;" vertex="1" parent="1">
