        <mxCell id="oufO-iJ00yhSnMANwlUW-1" value="&lt;h1 style=&quot;text-align: center&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; Système dé 20 !&lt;/h1&gt;&lt;div style=&quot;font-size: 17px&quot;&gt;&lt;ul&gt;&lt;li&gt;&lt;b&gt;1 = échec critique&lt;/b&gt;&lt;/li&gt;&lt;li&gt;&lt;b&gt;20 = réussite critique&lt;/b&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="text;html=1;fillColor=#d5e8d4;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=1;shadow=1;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="-100" y="-190" width="330" height="120" as="geometry" />
        </mxCell>
        <mxCell id="oufO-iJ00yhSnMANwlUW-2" value="&lt;div&gt;&lt;b style=&quot;font-size: 18px; text-align: left; background-color: initial;&quot;&gt;Affliction&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 18px;&quot;&gt;&lt;ul&gt;&lt;li style=&quot;text-align: left&quot;&gt;&lt;span style=&quot;font-size: 18px&quot;&gt;&lt;b&gt;ralenti&lt;/b&gt;: 1 action simple ou de mouvement (avec moitié moins de déplacement) dans le tour&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;text-align: left&quot;&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;aveuglement léger: &lt;/b&gt;malus de -5 pour tout ce qui touche à la vue (viser, toucher, observer, ...)&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;text-align: left&quot;&gt;&lt;b&gt;aveuglement grave: &lt;/b&gt;malus de -10 pour tout ce qui touche à la vue (viser, toucher, observer, ...)&lt;/li&gt;&lt;li style=&quot;text-align: left&quot;&gt;&lt;span style=&quot;&quot;&gt;&lt;b&gt;étourdi: &lt;/b&gt;ne peut faire aucune action, et à une défense diminué à 5&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;text-align: left&quot;&gt;&lt;b&gt;immobilisation: &lt;/b&gt;action de mouvement impossible&lt;/li&gt;&lt;li style=&quot;text-align: left&quot;&gt;&lt;b&gt;réduit au silence: &lt;/b&gt;incapacité de produire un son&lt;/li&gt;&lt;li style=&quot;text-align: left&quot;&gt;&lt;b&gt;réduit au silence magique: &lt;/b&gt;incapacité de lancer un sort&lt;b&gt;&amp;nbsp;&lt;/b&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;shadow=1;spacing=15;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="-1480" y="-820" width="380" height="460" as="geometry" />
