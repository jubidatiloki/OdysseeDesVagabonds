        </mxCell>
        <mxCell id="2rxSsDhHAnS-eIEXSBTq-2" value="&lt;h1&gt;#3 Armement&lt;/h1&gt;&lt;p&gt;(renforcement) maitrise de l&#39;arbalète et du fusil&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
