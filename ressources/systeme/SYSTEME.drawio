        <mxCell id="Ey6meIt2XCCsibth4jBo-1" value="&lt;h1&gt;#2 délivrance&amp;nbsp;&lt;/h1&gt;&lt;p&gt;(actif) test d&#39;attaque magique en opposition à un jet fait plus tot pour arreter l&#39;effet d&#39;un sort sur la durée&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
