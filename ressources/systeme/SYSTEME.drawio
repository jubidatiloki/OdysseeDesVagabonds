        <mxCell id="GnE5Q-5QsUphRtUW_GcG-46" value="&lt;div style=&quot;text-align: justify&quot;&gt;&lt;span style=&quot;font-size: 18px&quot;&gt;Le &lt;b&gt;dépassement de mana&lt;/b&gt;, sans subir d&#39;&lt;/span&gt;&lt;span style=&quot;font-size: 18px&quot;&gt;overdose magique&lt;/span&gt;&lt;b style=&quot;font-size: 18px&quot;&gt; &lt;/b&gt;&lt;span style=&quot;font-size: 18px&quot;&gt;immédiatement,&amp;nbsp; n&#39;est pas possible, sauf s&#39;il la personne possède la compétence &quot;transfert de mana&quot; du magicien. L&#39;&lt;b&gt;overdose magique&lt;/b&gt; inflige l&#39;excédent&amp;nbsp;de mana x2 en dégât de chaos et détruit le mana excédent. Seules les classes de mages (druide, magicien, nécromancien, prêtre) peuvent subir une overdose magique (les autres classes n&#39;étant pas dépendant de la magie et du mana).&amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;/div&gt;" style="text;html=1;fillColor=#dae8fc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;shadow=1;perimeterSpacing=10;spacing=15;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="-520" y="485" width="450" height="245" as="geometry" />
        </mxCell>
        <mxCell id="GnE5Q-5QsUphRtUW_GcG-47" value="&lt;div&gt;&lt;span style=&quot;font-size: 18px&quot;&gt;&lt;b&gt;Tailles de créatures :&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li style=&quot;text-align: left&quot;&gt;&lt;span style=&quot;font-size: 18px&quot;&gt;&lt;b&gt;minuscule &lt;/b&gt;: inférieur à 30cm&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;text-align: left&quot;&gt;&lt;span style=&quot;font-size: 18px&quot;&gt;&lt;b&gt;petite&lt;/b&gt; : entre 30cm et 1m20&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;text-align: left&quot;&gt;&lt;span style=&quot;font-size: 18px&quot;&gt;&lt;b&gt;moyenne &lt;/b&gt;: entre 1m20 et 1m80&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;text-align: left&quot;&gt;&lt;span style=&quot;font-size: 18px&quot;&gt;&lt;b&gt;grande&amp;nbsp;&lt;/b&gt;: entre 1m80 et et 3-4m&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;text-align: left&quot;&gt;&lt;span style=&quot;font-size: 18px&quot;&gt;&lt;b&gt;très grande&lt;/b&gt; : entre 3-4m et 10m&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;text-align: left&quot;&gt;&lt;span style=&quot;font-size: 18px&quot;&gt;&lt;b&gt;gigantesque &lt;/b&gt;: entre 10m et 25m&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;text-align: left&quot;&gt;&lt;span style=&quot;font-size: 18px&quot;&gt;&lt;b&gt;titanesque &lt;/b&gt;: supérieur à 25m&amp;nbsp;&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;shadow=1;spacing=15;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="-620" y="-20" width="340" height="230" as="geometry" />
        </mxCell>
        <mxCell id="GnE5Q-5QsUphRtUW_GcG-50" value="&lt;div style=&quot;font-size: 24px&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 24px&quot;&gt;Crochetage&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 17px&quot;&gt;&lt;ul&gt;&lt;li style=&quot;text-align: left&quot;&gt;&lt;span&gt;test de DEX&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;text-align: left&quot;&gt;&lt;span&gt;outil:&lt;/span&gt;&lt;/li&gt;&lt;ul&gt;&lt;li style=&quot;text-align: left&quot;&gt;&lt;span&gt;avec: pas de malus&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;text-align: left&quot;&gt;&lt;span&gt;sans: malus de -10&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;li style=&quot;text-align: left&quot;&gt;&lt;span&gt;si échec critique, les outils cassent&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fillColor=#f8cecc;shadow=1;strokeColor=#b85450;spacing=10;" vertex="1" parent="1">
