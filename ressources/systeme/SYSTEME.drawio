        <mxCell id="NVimz5JA0NgIxIB_Wmtv-222" value="&lt;h1&gt;#1 éducation&lt;/h1&gt;&lt;p&gt;(passif) + 1 connaissance / rang dans un domaine (cartographie, poisson, cuisine, géologie, ...)&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;glass=0;sketch=0;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="-379" y="1330" width="200" height="120" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-223" value="Voie bestiale" style="swimlane;startSize=23;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="2450" y="1360" width="220" height="850" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-224" value="&lt;h1&gt;#1 animal de compagnie&lt;/h1&gt;&lt;p&gt;(soutien) au choix:&lt;/p&gt;&lt;p&gt;panthère: +2 tests DEX&amp;nbsp;&lt;/p&gt;&lt;p&gt;loup: +2 tests MEN&amp;nbsp;&lt;/p&gt;&lt;p&gt;aigle: +2 tests PER&lt;/p&gt;&lt;p&gt;autres? (négociation avec le MJ)&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-223">
          <mxGeometry y="30" width="220" height="200" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-225" value="&lt;h1&gt;#2 transformation minime&lt;/h1&gt;&lt;p&gt;transformation (pour soi uniquement) en un animal minuscule, souris, chat, moineau, poisson rouge pendant 1d6 min&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-223">
          <mxGeometry y="230" width="220" height="180" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-227" value="&lt;h1&gt;#3 animal de combat&lt;/h1&gt;&lt;p&gt;l&#39;animal est capable d&#39;attauquer au tour de son compagnon, +RANG AdC, 1d8DMG&lt;/p&gt;&lt;p&gt;le bonus passe à +4&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-223">
          <mxGeometry y="393" width="220" height="120" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-228" value="&lt;h1&gt;#5 transformation majeure&lt;/h1&gt;&lt;p&gt;transformation en grand animal (gorille, loup, lion, requin, aigle royal) + utilisable sur une autre cible consentante&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-223">
          <mxGeometry y="700" width="220" height="150" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-229" value="Voie du protecteur" style="swimlane;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="2700" y="1360" width="200" height="730" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-230" value="&lt;h1&gt;#4 instinct de survie&lt;/h1&gt;&lt;p&gt;(passif) frisson lorsqu&#39;un danger approche (test diff 18 de PER (caché) pour savoir s&#39;il est mortel ou non)&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-229">
          <mxGeometry y="420" width="200" height="140" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-231" value="&lt;h1&gt;#2 écorces partagés&lt;/h1&gt;&lt;div&gt;(actif) possibilité de partagés le bonus avec ses alliés pour INT tours&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-229">
          <mxGeometry y="160" width="200" height="140" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-232" value="&lt;h1&gt;#5 pissenlit protecteur&lt;/h1&gt;&lt;p&gt;(actif) un pissenlit géant pousse autour du lanceur (ou d&#39;une cible) afin de protéger de dégâts extérieurs max INT personnes,&amp;nbsp; jusqu&#39;à 4 x NIVEAU x INT DMG pendant 2d6 + INT tours&lt;br&gt;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-229">
          <mxGeometry y="560" width="200" height="170" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-233" value="&lt;h1&gt;#1 Peau d&#39;écorce&lt;/h1&gt;&lt;p&gt;(passif) +1 DEF CaC, +1 DEF distance. passe à +2 au rang 3&lt;br&gt;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-229">
          <mxGeometry y="40" width="200" height="120" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-234" value="&lt;h1&gt;#3 brume&amp;nbsp;&lt;/h1&gt;&lt;p&gt;(actif) invoque un brouillard dense autour du groupe pendant 1d6 + INT tours, +5 discrétion, -5 AdC, -5 AdT, -5 tests d&#39;attaque magique&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-229">
          <mxGeometry y="287" width="200" height="130" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-235" value="Voie de la nature" style="swimlane;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="2960" y="1360" width="200" height="860" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-236" value="&lt;h1&gt;#1 enfant de la nature&lt;/h1&gt;&lt;p&gt;(passif) +2 / rang aux tests de déplacements et de survies en environnement difficiles (collines, montagnes, neiges, ... )&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-235">
          <mxGeometry y="30" width="200" height="140" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-237" value="&lt;h1&gt;#2 calme animal&lt;/h1&gt;&lt;p&gt;(passif) +2 / rang aux tests de SOC pour calmer et comprendre les émotions des animaux (faim, peur, curiosité, ...)&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-235">
          <mxGeometry y="180" width="200" height="150" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-238" value="&lt;h1&gt;#3 fruit de la vie&lt;/h1&gt;&lt;p&gt;(actif) fait pousser un petits arbres fruitiers contenant RANG fruits magique qui rendent chacun 1d6 + INT PV (se conserve 1 journée max, nécessite d&#39;être dans la nature, entouré de végétation)&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-235">
          <mxGeometry y="320" width="200" height="195" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-240" value="&lt;h1&gt;#4 invocation animal&lt;/h1&gt;&lt;p&gt;(actif) invoque un animal magique de taille moyenne au côté du joueur&amp;nbsp;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-235">
          <mxGeometry y="540" width="200" height="130" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-241" value="Voie des végétaux" style="swimlane;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="3217" y="1360" width="200" height="770" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-242" value="&lt;h1&gt;#5 plante carnivore&lt;/h1&gt;&lt;p&gt;(actif) fait sortir de sol une très grandes plantes carnivores qui obéit au druide ou attaque les ennemis à portée&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-241">
          <mxGeometry y="620" width="200" height="150" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-243" value="&lt;h1&gt;#1 vie sylvestre&lt;/h1&gt;&lt;p&gt;(passif) +3 INIT et +2 tests de PER si entouré de végétation&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-241">
          <mxGeometry y="20" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-244" value="&lt;h1&gt;#4 arbrification&lt;/h1&gt;&lt;p&gt;(actif) transformation qn ou soi meme en arbre, l&#39;empêchant d&#39;agir ou de bouger, gagne 10 de RD physique, régénère 1d6 PV par tour, peut être annulé par le lanceur,&amp;nbsp;&lt;span&gt;&amp;nbsp;si c&#39;est qn d&#39;autre test d&#39;opposition de CON&amp;nbsp; et dure&amp;nbsp;&lt;/span&gt;&lt;span&gt;INT tours.&amp;nbsp;&lt;/span&gt;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-241">
          <mxGeometry y="440" width="200" height="190" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-245" value="&lt;h1&gt;#2 se fondre dans la nature&lt;/h1&gt;&lt;p&gt;(passif) +5 discrétion pour se fondre dans la nature, (actif) peut l&#39;appliquer à ses alliés&amp;nbsp;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-241">
          <mxGeometry y="120" width="200" height="130" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-246" value="&lt;h1&gt;#3 lianes immobilisantes&lt;/h1&gt;&lt;p&gt;(actif) fait pousser des lianes très rapidement aux pieds de ses énemis les empechant de bouger pendant 1d6 / 2 tours (réduits par 2 sur les grandes et+ créatures)&amp;nbsp;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-241">
          <mxGeometry y="260" width="200" height="169" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-247" value="Voie du bouclier" style="swimlane;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="-450" y="3100" width="200" height="670" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-248" value="&lt;h1&gt;#1 formation&lt;/h1&gt;&lt;p&gt;(passif) bouclier n&#39;applique pas d&#39;encombrement de DEF&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-247">
          <mxGeometry y="30" width="200" height="150" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-249" value="&lt;h1&gt;#2 A couvert&lt;/h1&gt;&lt;p&gt;(actif)&amp;nbsp; le guerrier peut lever son bouclier pour se déplacer(ou non) à couvert, il gagne ainsi +3 DEF CaC, DIST, MAG et ELEM&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-247">
          <mxGeometry y="110" width="200" height="150" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-250" value="&lt;h1&gt;#3 protection&lt;/h1&gt;&lt;p&gt;(renforcement) s&#39;il ne s&#39;est pas déplacé durant son tour, le guerrier peut faire profiter de sa défense à un allié pour intercepter un coup à sa place&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-247">
          <mxGeometry y="230" width="200" height="150" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-251" value="&lt;h1&gt;#4 bouclier magique&lt;/h1&gt;&lt;p&gt;todo&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-247">
          <mxGeometry y="360" width="200" height="150" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-252" value="&lt;h1&gt;#5 Egide&lt;/h1&gt;&lt;p&gt;(renforcement) s&#39;il ne s&#39;est pas déplacé durant son tour, le guerrier peut faire profiter de sa défense à un allié pour intercepter un coup à sa place&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-247">
          <mxGeometry y="520" width="200" height="150" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-253" value="Voie de la mêlée" style="swimlane;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="-180" y="3100" width="200" height="860" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-254" value="&lt;h1&gt;#1 formation&lt;/h1&gt;&lt;p&gt;(passif) +1 AdC / rang&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-253">
          <mxGeometry y="30" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-255" value="&lt;h1&gt;#2 frappe de précision&lt;/h1&gt;&lt;p&gt;(actif) utilise un D12 pour attaquer, si l&#39;attaque touche, ajoute 2D6 aux DMG&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-253">
          <mxGeometry y="120" width="200" height="150" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-256" value="&lt;h1&gt;#3 coup de boucher&lt;/h1&gt;&lt;p&gt;(action complexe) attaque brutale qui a pour but de couper plus que de blesser, DMG / 2 mais D6 --&amp;gt; 5-6 membre tranché ou entaillé suffisamment pour lacher l&#39;arme&amp;nbsp;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-253">
          <mxGeometry y="250" width="200" height="180" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-258" value="&lt;h1&gt;#4 arme de prédilection&lt;/h1&gt;&lt;p&gt;(passif) choisit un type d&#39;arme (épée longue, hache, ...), et ajout 1d4 DMG et +2 AdC sur ce type d&#39;arme (peut etre changer en prenant une formation auprès d&#39;un maître d&#39;arme )&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-253">
          <mxGeometry y="440" width="200" height="170" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-257" value="&lt;h1&gt;#5 ambidextrie&lt;/h1&gt;&lt;p&gt;(renforcement) possibilité d&#39;avoir une 2eme arme équipé (à une main, épée + pistolet possible), possibilité d&#39;attaquer avec sa 2eme arme pour une action de mouvement&lt;/p&gt;&lt;p&gt;(renforcement) coup du boucher --&amp;gt; membre tranché sur 4-6 + critique dégât = membre tranché + dégât non réduit&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-253">
          <mxGeometry y="620" width="200" height="230" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-259" value="Voie de la guerre" style="swimlane;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="370" y="3100" width="206" height="790" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-260" value="&lt;h1&gt;#2 Contre attaque&lt;/h1&gt;&lt;p&gt;(passif) si une attaque de contact contre le guerrier rate et si attaque &amp;lt; DEF-5 --&amp;gt; action d&#39;attaque gratuite &lt;b&gt;avec un 1d12 (au lieu d&#39;un D20)&lt;/b&gt;&lt;/p&gt;&lt;p&gt;&lt;b&gt;max 1 fois&lt;/b&gt; par tour&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-259">
          <mxGeometry y="140" width="200" height="180" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-261" value="&lt;h1&gt;#3 Contre attaque améliorée&lt;/h1&gt;&lt;p&gt;(renforcement) si une attaque de contact contre le guerrier rate et si attaque &amp;lt; DEF-5 --&amp;gt; action d&#39;attaque gratuite (avec D20)&lt;/p&gt;&lt;p&gt;&lt;b&gt;max 2 fois&lt;/b&gt; par tour&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-259">
          <mxGeometry x="-6" y="320" width="206" height="220" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-262" value="&lt;h1&gt;#4 Tenir une position&lt;/h1&gt;&lt;p&gt;pas de déplacement ce tour mais bonus&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-259">
          <mxGeometry y="520" width="206" height="170" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-263" value="&lt;h1&gt;#1 rangs serrés&lt;/h1&gt;&lt;p&gt;(passif) +1 DEF Cac par alliés au contact (max +3)&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-259">
          <mxGeometry y="30" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-264" value="Voie de la polyvalence" style="swimlane;startSize=23;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="100" y="3100" width="200" height="850" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-265" value="&lt;h1&gt;#3 jonglage d&#39;arme&lt;/h1&gt;&lt;p&gt;(passif) changer d&#39;arme:&lt;/p&gt;&lt;p&gt;action simple --&amp;gt; action gratuite&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-264">
          <mxGeometry y="350" width="200" height="130" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-266" value="&lt;h1&gt;#1 Archerie&lt;/h1&gt;&lt;p&gt;(passif) maitrise de toutes les armes à distance qui ne soit pas de sièges (arcs, arbalètes, pistolet, mousquet, ..)&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-264">
          <mxGeometry y="30" width="200" height="150" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-267" value="&lt;h1&gt;#2 posture défensive&lt;/h1&gt;&lt;p&gt;(gratuit) 1f/tour, le guerrier peut choisir d&#39;adopter une posture défensifve dans cette posture, il gagne +3DEF &lt;b&gt;mais &lt;/b&gt;ne peut pas sprinter dans cette posture (utiliser ces 2 actions de mouvements pendant un même tour)&amp;nbsp;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-264">
          <mxGeometry y="150" width="200" height="200" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-268" value="&lt;h1&gt;#4 posture offensive&lt;/h1&gt;&lt;p&gt;(gratuit) 1f/tour, le guerrier peut choisir d&#39;adopter offensive, il gagne +3 AdC et +1d6 aux dégâts, &lt;b&gt;mais &lt;/b&gt;subit un malus de -3 DEF dans cette posture&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-264">
          <mxGeometry y="480" width="200" height="170" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-269" value="Voie de l&#39;artillerie" style="swimlane;startSize=23;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="2430" y="3005" width="210" height="965" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-270" value="&lt;h1&gt;#1 apprenti artilleur&lt;/h1&gt;&lt;p&gt;+2 / rang au test liés au fait de maitriser, utiliser et comprendre le fonctionnement d&#39;une arme de siège&lt;/p&gt;&lt;p&gt;+ maitrise des armes à poudres et des armes de sièges&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-269">
          <mxGeometry y="20" width="210" height="170" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-272" value="&lt;h1&gt;#3 artilleur confirmé&lt;/h1&gt;&lt;p&gt;(renforcement) rechargement canon à 2 mains = action de mouvement&lt;/p&gt;&lt;p&gt;+2 DMG avec des armes à poudre légères&lt;/p&gt;&lt;p&gt;+5 DMG avec des armes à poudres lourdes&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-269">
          <mxGeometry y="340" width="210" height="210" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-273" value="&lt;h1&gt;#2 canon à mains&lt;/h1&gt;&lt;p&gt;retrouve, trouve, achète, obtient (à voir avec le MJ) un petit canon à mains, permet de tirer un boulet, portée 40m, 3D10 DMG, rechargement = action complexe (rechargement rapide ne marche pas sur ce canon)&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-269">
          <mxGeometry y="190" width="210" height="160" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-274" value="&lt;h1&gt;#4 médecin de campagne&lt;/h1&gt;&lt;p&gt;(complexe) peut stabiliser une personne blessé physiquement et lui rend 4D4 PV&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-269">
          <mxGeometry y="555" width="210" height="125" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-275" value="Voie du chimiste" style="swimlane;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="2680" y="3005" width="210" height="970" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-276" value="&lt;h1&gt;#3 projectile&amp;nbsp; explosif&lt;/h1&gt;&lt;p&gt;permet de fabriquer un petit projectile qui explose à l&#39;impact sur un rayon de 3-4m, en infligeant 2D6 DMG, temps de fabrication d&#39;un projectile = 1h, test d&#39;attaque / lancer de DEX&lt;/p&gt;&lt;p&gt;+ déblocage: potion de poison&amp;nbsp;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-275">
          <mxGeometry y="380" width="210" height="210" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-277" value="&lt;h1&gt;#5 sapeur&lt;/h1&gt;&lt;p&gt;amélioration projectile explosif: le rayon passe à 4-6m, les dégats passe à 4d6&lt;/p&gt;&lt;p&gt;+ amélioration démolisseur&lt;/p&gt;&lt;p&gt;+ déblocage: potions magiques (nécessite l&#39;aide d&#39;un magicien connaissant le sort)&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-275">
          <mxGeometry y="760" width="210" height="210" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-278" value="&lt;h1&gt;#1 chimiste en herbe&lt;/h1&gt;&lt;p&gt;+2 / rang au test pour réaliser de la poudre à canon, pour les armes à feu ou pour réaliser des potions, fabrication max RANGx2 potions par jour, 10min de préparation pour chaque&lt;/p&gt;&lt;p&gt;+ déblocage: potion de santé&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-275">
          <mxGeometry y="30" width="210" height="190" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-279" value="&lt;h1&gt;#2 expertise de la poudre&lt;/h1&gt;&lt;p&gt;+ ajoute sa DEX aux dégâts d&#39;une arme à feu&lt;/p&gt;&lt;p&gt;+ déblocage: potion de fer&amp;nbsp;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-275">
          <mxGeometry y="235" width="210" height="135" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-280" value="&lt;h1&gt;#4 démolisseur&lt;/h1&gt;&lt;p&gt;permet de fabriquer une charge d&#39;explosif permettant de percer un mur, une structure ou un coffre,&amp;nbsp; temps d&#39;installation d&#39;une charge = 2 tours, temps de fabrication d&#39;une charge = 3h&lt;/p&gt;&lt;p&gt;+ déblocage: potion de réussite&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-275">
          <mxGeometry y="580" width="210" height="170" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-281" value="Voie du tireur" style="swimlane;startSize=30;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="2940" y="3005" width="210" height="750" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-282" value="&lt;h1&gt;#2 tenir en joue&lt;/h1&gt;&lt;p&gt;action de mouvement: tient en joue une cible, qui subit une attaque gratuite de l&#39;ingénieur s&#39;il se déplace&amp;nbsp;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-281">
          <mxGeometry y="130" width="210" height="120" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-283" value="&lt;h1&gt;#4 rechargement rapide&lt;/h1&gt;&lt;p&gt;rechargement gratuit après avoir tiré (ne marche pas avec 2 armes équipés)&lt;/p&gt;+ amélioration tenir en joue: peut tenir 3 cibles proches en joue (ne peut tirer qu&#39;une fois en réaction dans un tour)" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-281">
          <mxGeometry y="370" width="210" height="190" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-284" value="&lt;h1&gt;#1 entraînement au tir&lt;/h1&gt;&lt;p&gt;(passif) +1 AdT / rang avec des armes à feu&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-281">
          <mxGeometry y="30" width="210" height="120" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-285" value="&lt;h1&gt;#3 pistoléro&lt;/h1&gt;&lt;p&gt;peut utiliser deux armes à feu à une main en même temps en utilisant un D12 au lieu d&#39;un D20 pour toucher sa cible, 2 tirs possibles dans le tour comme une action d&#39;attaque (si un seul tir --&amp;gt; D20 et un bonus supplémentaire de +2)&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-281">
          <mxGeometry y="225" width="210" height="155" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-286" value="&lt;h1&gt;#5 as de la gâchette&lt;/h1&gt;&lt;p&gt;amélioration pistoléro: utilise des D20 (avec 2 armes équipés) et ajoute 2D10 dégâts avec 1 seule arme équipé&amp;nbsp;&lt;/p&gt;&lt;p&gt;+ amélioration rechargement rapide: marche dorénavant avec 2 armes équipés&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-281">
          <mxGeometry y="550" width="210" height="200" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-287" value="Voie des mécanismes" style="swimlane;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="3200" y="3005" width="210" height="1000" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-288" value="&lt;h1&gt;#3 automate&lt;/h1&gt;&lt;p&gt;permet de fabriquer un petit automate d&#39;engrenage et de métal qui peut porter du matériel ou tout simplement être vendu à des riches&amp;nbsp;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-287">
          <mxGeometry y="360" width="210" height="120" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-289" value="&lt;h1&gt;#5 golem&lt;/h1&gt;&lt;p&gt;l&#39;ingénieur peut se construire une golem et lui installer un module permettant de le spécialiser :&lt;/p&gt;&lt;p&gt;- artilleur -&amp;gt; canon sur l&#39;épaule&lt;/p&gt;&lt;p&gt;- protecteur -&amp;gt; bouclier sur le bras&lt;/p&gt;&lt;p&gt;- mobile -&amp;gt; allégement de la structure, moins encombrant et moins gêné par les endroit exigus&lt;/p&gt;&lt;p&gt;- combattant -&amp;gt; armes de CaC ou mains faite pour se battre&lt;/p&gt;&lt;p&gt;- mûle -&amp;gt; buste ouvrable faisant office de rangement&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-287">
          <mxGeometry y="715" width="210" height="280" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-290" value="&lt;h1&gt;#1 mécanicien&lt;/h1&gt;&lt;p&gt;+2 / rang aux tests liés à la mécanique et à la compréhension d&#39;un mécanisme (engrenage, piston, marchines, ...)&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-287">
          <mxGeometry y="40" width="210" height="120" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-291" value="&lt;h1&gt;#2 physique appliquée&lt;/h1&gt;&lt;p&gt;+5 aux tests de FOR ou DEX&amp;nbsp; / pouvant être optimisé par des connaissances physique poussées (utiliser un levier pour soulever qch de lourd, peut s&#39;appliquer au lancer de projectile explosif)&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-287">
          <mxGeometry y="170" width="210" height="170" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-292" value="&lt;h1&gt;#4 bidouillage&lt;/h1&gt;&lt;p&gt;peut améliorer une arme à poudre pour l&#39;équivalent de 10pa de pièces) :&lt;/p&gt;&lt;p&gt;crosse modifiée : +3AdT&lt;/p&gt;&lt;p&gt;canon vissé: +1D6 DMG&lt;/p&gt;&lt;p&gt;chargeur: peut tirer 2 balles de plus sans recharger (augmente d&#39;autant le nombre de réaction avec tenir en joue dans un même tour)&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-287">
          <mxGeometry y="500" width="210" height="210" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-293" value="&lt;h1&gt;/!\ pas de sort d&#39;attaque au rang 1&lt;/h1&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="-1500" y="4790" width="190" height="110" as="geometry" />
        </mxCell>
