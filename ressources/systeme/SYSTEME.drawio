          <mxGeometry x="-530" y="1220" width="260" height="770" as="geometry" />
        </mxCell>
        <mxCell id="jGQSzNbYtyzCzQj3RQxu-4" value="&lt;h1&gt;#1 batard&lt;/h1&gt;&lt;p&gt;&lt;font style=&quot;font-size: 16px&quot;&gt;le draconien, doté de pattes puissante et d&#39;une grande mâchoire peut mordre ou griffer au prix d&#39;une action d&#39;attaque, 1D6 + FOR DMG&amp;nbsp;&lt;/font&gt;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=default;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;glass=0;fontColor=default;" vertex="1" parent="jGQSzNbYtyzCzQj3RQxu-3">
          <mxGeometry y="30" width="260" height="170" as="geometry" />
        </mxCell>
        <mxCell id="jGQSzNbYtyzCzQj3RQxu-5" value="&lt;h1&gt;&amp;nbsp; &amp;nbsp;passif racial&amp;nbsp;&lt;/h1&gt;&lt;p style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;Passé de violence&lt;/b&gt;: Une fois par jour, +5 aux tests pour intimider ou faire fuir de peur une cible de taille moyenne, +2 pour une cible de grande taille (tests de CHAR en opposition pour la cible)&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;/p&gt;" style="text;html=1;strokeColor=#6c8ebf;fillColor=#FFFFFF;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=1;glass=0;shadow=1;" vertex="1" parent="Fy31WUsdD2yVTO4LC-Jr-1">
          <mxGeometry x="350" y="1520" width="250" height="190" as="geometry" />
        </mxCell>
        <mxCell id="jGQSzNbYtyzCzQj3RQxu-6" value="&lt;h1&gt;&amp;nbsp; Bonus de stat&lt;/h1&gt;&lt;p&gt;&lt;font style=&quot;font-size: 16px&quot;&gt;+3 FOR, -2 INT, -2 SOC&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;/p&gt;" style="text;html=1;strokeColor=#82b366;fillColor=#FFFFFF;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=1;shadow=1;" vertex="1" parent="Fy31WUsdD2yVTO4LC-Jr-1">
          <mxGeometry x="372.5" y="1770" width="205" height="115" as="geometry" />
        </mxCell>
        <mxCell id="jGQSzNbYtyzCzQj3RQxu-7" value="&lt;h1&gt;&lt;span&gt;dé de vie:&amp;nbsp; 10&lt;/span&gt;&lt;/h1&gt;&lt;div&gt;&lt;b&gt;&lt;font style=&quot;font-size: 24px&quot;&gt;dé de mana: 4&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;" style="text;html=1;strokeColor=#b85450;fillColor=#FFFFFF;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=1;shadow=1;" vertex="1" parent="Fy31WUsdD2yVTO4LC-Jr-1">
          <mxGeometry x="380" y="1350" width="190" height="90" as="geometry" />
        </mxCell>
        <mxCell id="jGQSzNbYtyzCzQj3RQxu-8" value="Voie du demi-orque" style="swimlane;" vertex="1" parent="Fy31WUsdD2yVTO4LC-Jr-1">
          <mxGeometry x="900" y="1220" width="200" height="770" as="geometry" />
        </mxCell>
        <mxCell id="jGQSzNbYtyzCzQj3RQxu-9" value="&lt;h1&gt;&amp;nbsp; &amp;nbsp;passif racial&amp;nbsp;&lt;/h1&gt;&lt;p style=&quot;font-size: 16px&quot;&gt;&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;héritage draconique&lt;/b&gt;, au choix:&amp;nbsp;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;font-size: 16px&quot;&gt;&lt;/p&gt;&lt;ul style=&quot;font-size: 16px&quot;&gt;&lt;li&gt;&lt;font style=&quot;font-size: 16px&quot;&gt;souffle élémentaire: 1D6 DMG d&#39;un souffle (feu, glace, foudre) re lançable après 1D4 tours (possède des petites cornes sur la tête, n&#39;a pas d&#39;ailes)&lt;br&gt;&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 16px&quot;&gt;ailes vestigiales: peut voler pendant CON tours max (doit se poser après pour reposer ses ailes) (possède donc des ailes atrophiées, n&#39;a pas de cornes)&lt;/font&gt;&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;/p&gt;" style="text;html=1;strokeColor=#6c8ebf;fillColor=#FFFFFF;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=1;glass=0;shadow=1;" vertex="1" parent="Fy31WUsdD2yVTO4LC-Jr-1">
          <mxGeometry x="-1057" y="2900" width="270" height="310" as="geometry" />
        </mxCell>
        <mxCell id="jGQSzNbYtyzCzQj3RQxu-10" value="&lt;h1&gt;&lt;span&gt;dé de vie:&amp;nbsp; 8&lt;/span&gt;&lt;/h1&gt;&lt;div&gt;&lt;b&gt;&lt;font style=&quot;font-size: 24px&quot;&gt;dé de mana: 4&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;" style="text;html=1;strokeColor=#b85450;fillColor=#FFFFFF;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=1;shadow=1;" vertex="1" parent="Fy31WUsdD2yVTO4LC-Jr-1">
