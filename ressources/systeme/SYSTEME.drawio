        <mxCell id="PRqGWWr7hAl_Sj7m-B9w-2" value="&lt;h1&gt;#4 Guérison&lt;/h1&gt;&lt;p&gt;(actif)(sort) soigne de 5D6 PV une cible au contact et guéris des maladie (non magique et magique mineure)&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
