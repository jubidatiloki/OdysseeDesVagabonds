        <mxCell id="1E0pnR5yacwigoUuw52S-1" parent="sPp2nEJlRjR283OlNyq3-0" style="text;html=1;strokeColor=#000000;fillColor=#e1d5e7;spacing=15;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=1;shadow=1;labelBackgroundColor=none;fontSize=20;strokeWidth=2;" value="&lt;h1 style=&quot;text-align: center; font-size: 20px;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Aptitude de tir (AT)&lt;/font&gt;&lt;/h1&gt;&lt;div style=&quot;font-size: 20px;&quot;&gt;&lt;span id=&quot;docs-internal-guid-48394b25-7fff-48b4-457b-531c8bb70d35&quot; style=&quot;font-size: 20px;&quot;&gt;&lt;span style=&quot;font-family: arial; background-color: transparent; vertical-align: baseline; font-size: 20px;&quot;&gt;Maîtrise des armes à distance, importante pour les &lt;/span&gt;&lt;span style=&quot;font-family: arial; background-color: transparent; font-weight: 700; vertical-align: baseline; font-size: 20px;&quot;&gt;ingénieurs&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-family: arial; background-color: transparent; vertical-align: baseline; font-size: 20px;&quot;&gt;et les &lt;/span&gt;&lt;span style=&quot;font-family: arial; background-color: transparent; font-weight: 700; vertical-align: baseline; font-size: 20px;&quot;&gt;rôdeurs&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;&lt;br style=&quot;font-size: 20px;&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 20px;&quot;&gt;&lt;ul style=&quot;font-size: 20px;&quot;&gt;&lt;li dir=&quot;ltr&quot; style=&quot;list-style-type: disc; font-family: arial; background-color: transparent; vertical-align: baseline; font-size: 20px;&quot;&gt;&lt;p dir=&quot;ltr&quot; style=&quot;line-height: 1.38; margin-top: 0pt; margin-bottom: 0pt; font-size: 20px;&quot;&gt;&lt;span style=&quot;background-color: transparent; vertical-align: baseline; font-size: 20px;&quot;&gt;permet d’augmenter les chances de toucher à distance (toucher bonus = AT)&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;li dir=&quot;ltr&qu