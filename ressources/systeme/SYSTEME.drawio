        <mxCell id="NVimz5JA0NgIxIB_Wmtv-1" value="BARBARE" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;strokeWidth=11;fontSize=75;fontStyle=1" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="-1180" y="-765" width="836" height="30" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-4" value="&lt;font style=&quot;font-size: 35px;&quot;&gt;Dé de vie: &lt;/font&gt;&lt;font style=&quot;font-size: 35px;&quot;&gt;&lt;font style=&quot;font-size: 35px;&quot; color=&quot;#00994d&quot;&gt;&lt;b style=&quot;font-size: 35px;&quot;&gt;+&lt;/b&gt;&lt;/font&gt;&lt;br style=&quot;font-size: 35px;&quot;&gt;&lt;span style=&quot;font-size: 35px;&quot;&gt;Dé de mana: &lt;/span&gt;&lt;font style=&quot;font-size: 35px;&quot; color=&quot;#ff0000&quot;&gt;&lt;b style=&quot;font-size: 35px;&quot;&gt;-&amp;nbsp;&lt;/b&gt;&lt;/font&gt;&lt;/font&gt;" style="text;html=1;strokeColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;shadow=1;fillColor=#ffffff;fontSize=35;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="-1010" y="-570" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-5" value="&lt;b style=&quot;font-size: 30px;&quot;&gt;Inventaire de base&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;rounded=1;shadow=1;fontSize=30;fillColor=#FCFCFC;fontColor=#333333;strokeColor=#666666;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="-1060" y="-390" width="390" height="370" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-7" value="Voie de la brute" style="swimlane;fillColor=#FCFCFC;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="-490" y="-630" width="230" height="940" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-8" value="&lt;h1&gt;#1 Force de la nature&lt;/h1&gt;&lt;p&gt;(passif) Le barbare peut désormais choisir d&#39;utiliser sa CON ou sa FOR pour le gain de PV lors d&#39;une montée de niveau.&lt;/p&gt;&lt;p&gt;à la prise de cette compétence, ajoute sa FOR à ses PV MAX&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-7">
          <mxGeometry y="30" width="230" height="220" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-9" value="&lt;h1&gt;#3 style barbaresque&lt;/h1&gt;&lt;p&gt;(renforcement) ajoute sa FOR &lt;b&gt;et&lt;/b&gt; sa CON&amp;nbsp; à son montant de PV à la montée de niveau&lt;br&gt;(passif) Le barbare ajoute son mod de FOR à ses tests de MEN et à ceux de ses alliés au contact pour les tests de négociation, de persuasion ou d&#39;intimidation..&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-7">
          <mxGeometry y="370" width="230" height="210" as="geometry" />
        </mxCell>
        <mxCell id="XfynLsl9VJbfqvHa0huY-4" value="&lt;h1&gt;#2 brutalité&lt;/h1&gt;&lt;p&gt;(actif complexe) (compétence) nécessite une arme à 2 mains, assène un puissant coup avec son arme, ajout RANGx2 aux dégâts d&#39;attaque&amp;nbsp;&amp;nbsp;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-7">
          <mxGeometry y="250" width="230" height="120" as="geometry" />
        </mxCell>
        <mxCell id="K8GHHQCG2zdm2UY4ew2e-1" value="&lt;h1&gt;#5 légende brutale&lt;/h1&gt;&lt;p&gt;(passif) gagne +2 en FOR&lt;br&gt;(renforcement) peut désormais utiliser une arme à 2 mains dans chaque main, avoir avoir son action de mouvement (tjrs 1d12 pour la 2eme attaque)&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-7">
          <mxGeometry y="770" width="230" height="170" as="geometry" />
        </mxCell>
        <mxCell id="_B1Yem7GfNSOAfVmhYR--0" value="&lt;h1&gt;#4 armement barbare&lt;/h1&gt;&lt;p&gt;(passif) peut désormais utiliser une arme à 2 mains dans chaque main, 2 attaques possible dans le tour, 1d12 pour la 2eme attaque et pas d&#39;action de mouvement si 2 attaques&amp;nbsp;&lt;/p&gt;&lt;p&gt;(passif) +5 MEN lorsqu&#39;il a 2 armes à 2 mains équipés&amp;nbsp;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-7">
          <mxGeometry y="580" width="230" height="190" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-10" value="Voie de l&#39;athlète" style="swimlane;fillColor=#FCFCFC;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="-200" y="-630" width="230" height="990" as="geometry" />
        </mxCell>
        <mxCell id="K8GHHQCG2zdm2UY4ew2e-2" value="&lt;h1&gt;#4 TODO moulinet mortel&lt;/h1&gt;&lt;p&gt;(renforcement) le moulinet n&#39;a plus de dégât réduit pour chaque cible touché (toujours la réduction de défense au prochain tour)&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-10">
          <mxGeometry y="540" width="230" height="160" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-11" value="Voie du sauvage" style="swimlane;fillColor=#FCFCFC;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="100" y="-630" width="200" height="890" as="geometry" />
        </mxCell>
        <mxCell id="YcEv4BVhf_AayOgC7CD4-0" value="&lt;h1&gt;#1 légèreté animale&amp;nbsp;&lt;/h1&gt;&lt;p&gt;(passif) si le barbare a une armure de cuir (ou moins) équipé, gagne RANG DEF&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-11">
          <mxGeometry y="20" width="200" height="140" as="geometry" />
        </mxCell>
        <mxCell id="jRkD0fH0RAPi-SV-QS84-1" value="&lt;h1&gt;#2 charge bestiale&lt;/h1&gt;&lt;p&gt;(actif) (compétence) doit être équipé d&#39;un armes dans chaque main ou une à 2 mains, cours sur ses ennemis en criant et en faisant des grands mouvements avec son/ses armes sur 20m, la première attaque a +3AdC et +1d6 DM&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-11">
          <mxGeometry y="150" width="200" height="190" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-12" value="Voie du berzerker" style="swimlane;fillColor=#FCFCFC;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="410" y="-630" width="230" height="1080" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-14" value="&lt;h1&gt;#4 Déchainement&lt;/h1&gt;&lt;p&gt;(renforcement) la frénésie inflige désormais initialement 2D6 + FOR DMG (avec tjrs la possibilité de relancer le/les dé(s) qui font les dégats max (6))&lt;br&gt;&lt;br&gt;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-12">
          <mxGeometry y="730" width="230" height="110" as="geometry" />
        </mxCell>
        <mxCell id="_B1Yem7GfNSOAfVmhYR--1" value="&lt;h1&gt;#1 rage berzerker&lt;/h1&gt;&lt;p&gt;(gratuit) (compétence) 1fois / jour, libère sa rage en poussant un puissant cri, et rentre dans l&#39;état berzerker pendant 1D4 + CON tours&lt;/p&gt;&lt;p&gt;les +&lt;/p&gt;&lt;p&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;+1d6 DMG par attaque&lt;/li&gt;&lt;li&gt;insensible aux effets d&#39;entraves non-magique (désarmement, assommement, mise au sol, ..) (tjrs sensible aux entraves magique)&lt;/li&gt;&lt;/ul&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;les - :&lt;br&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;-3 DEF DIST, MAG et ELEM&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;-3 ESQ&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;-2 tests d&#39;attaque&lt;/span&gt;&lt;/li&gt;&lt;li&gt;ne fait pas de distinction amis - ennemis (cherche à attaquer le plus proche)&lt;/li&gt;&lt;li&gt;arrêter soi-même prématurément, la rage berzerker nécessite un test de CON diff 15&lt;/li&gt;&lt;/ul&gt;&lt;/span&gt;&lt;p&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;br&gt;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-12">
          <mxGeometry y="30" width="230" height="410" as="geometry" />
        </mxCell>
        <mxCell id="uApg3a5MT0ERVzc8dN9p-0" value="&lt;h1&gt;#2 frénésie&lt;/h1&gt;&lt;p&gt;(action complexe) (compétence) attaque frénétique qui inflige +1D6 DMG, si dé de degat max(6), relance du dé (et ajout du cumul)&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-12">
          <mxGeometry y="440" width="230" height="110" as="geometry" />
        </mxCell>
        <mxCell id="uApg3a5MT0ERVzc8dN9p-1" value="&lt;h1&gt;#5 rage maitrisée&lt;/h1&gt;&lt;p&gt;(passif) +2 FOR, +2 CON&lt;/p&gt;&lt;p&gt;(renforcement)&lt;/p&gt;&lt;p&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;3 fois / jour&lt;/li&gt;&lt;li&gt;durée --&amp;gt; 1d6 + FOR + CON tours&lt;/li&gt;&lt;li&gt;DMG supplémentaires --&amp;gt; +1d10&lt;/li&gt;&lt;li&gt;malus tests d&#39;attaque --&amp;gt; plus de malus&lt;/li&gt;&lt;li&gt;arret de la rage --&amp;gt; test CON diff 10&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-12">
          <mxGeometry y="842.5" width="230" height="237.5" as="geometry" />
        </mxCell>
