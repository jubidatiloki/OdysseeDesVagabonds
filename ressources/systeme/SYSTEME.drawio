        <mxCell id="hxCgloDH0I7pbzZVVPKQ-1" value="&lt;h1 style=&quot;line-height: 100%;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;niveau de potion ?&amp;nbsp;&lt;/font&gt;&lt;/h1&gt;&lt;h1 style=&quot;line-height: 100%;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;(1 - 3 par exemple, peu efficace - très efficace)&lt;/font&gt;&lt;/h1&gt;" style="text;html=1;strokeColor=default;fillColor=#f5f5f5;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=1;fontSize=18;fontColor=#333333;" vertex="1" parent="1">
