        <mxCell id="2rxSsDhHAnS-eIEXSBTq-4" value="&lt;h1&gt;#4 flèches multiples&lt;/h1&gt;&lt;p&gt;(complexe) peut au choix:&lt;/p&gt;&lt;p&gt;- encocher 3 flèches sur 3 cibles différentes&lt;/p&gt;&lt;p&gt;- 2 flèches sur la même cible&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
