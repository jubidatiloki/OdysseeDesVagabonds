          <mxGeometry x="431" y="1290" width="200" height="810" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-217" value="&lt;h1&gt;#1 meneur&lt;/h1&gt;&lt;p&gt;&lt;font style=&quot;font-size: 14px&quot;&gt;(passif) +1 /rang aux tests pour convaincre ou encourager des gens à suivre le chevalier et à l&#39;écouter&lt;/font&gt;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;glass=0;sketch=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-216">
          <mxGeometry y="40" width="200" height="120" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-218" value="&lt;h1&gt;#2 montrer l&#39;exemple&lt;/h1&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px&quot;&gt;la première fois dans un combat que le chevalier tue une créature de taille moyenne (ou supérieure), cela motive ses alliés autour de lui qui gagne +5 à leur prochain jet&lt;/span&gt;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;glass=0;sketch=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-216">
          <mxGeometry y="170" width="200" height="200" as="geometry" />
        </mxCell>
