        <mxCell id="1E0pnR5yacwigoUuw52S-12" parent="sPp2nEJlRjR283OlNyq3-2" style="text;html=1;strokeColor=#000000;fillColor=#ffe6cc;spacing=15;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=1;shadow=1;labelBackgroundColor=none;fontSize=20;strokeWidth=2;" value="&lt;h1 style=&quot;text-align: center; font-size: 20px;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Points de vie (PV)&lt;/font&gt;&lt;/h1&gt;&lt;div style=&quot;font-size: 20px;&quot;&gt;&lt;span id=&quot;docs-internal-guid-b447926c-7fff-8431-5308-e439b8fcf09d&quot; style=&quot;font-size: 20px;&quot;&gt;&lt;span style=&quot;font-family: arial; background-color: transparent; vertical-align: baseline; font-size: 20px;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Représente la quantité de coup et de blessure qu’il est possible d’encaisser avant de s’évanouir ou de mourir&lt;/font&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;&lt;br style=&quot;font-size: 20px;&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 20px;&quot;&gt;&lt;ul style=&quot;font-size: 20px;&quot;&gt;&lt;li dir=&quot;ltr&quot; style=&quot;list-style-type: disc; font-family: arial; background-color: transparent; vertical-align: baseline; font-size: 20px;&quot;&gt;&lt;p dir=&quot;ltr&quot; style=&quot;line-height: 1.38; margin-top: 0pt; margin-bottom: 0pt; font-size: 20px;&quot;&gt;&lt;span style=&quot;background-color: transparent; vertical-align: baseline; font-size: 20px;&quot;&gt;point de vie = 0 → évanouissement pendant 1d6 heures&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;li dir=&quot;ltr&quot; style=&quot;list-style-type: disc; font-family: arial; background-color: transparent; vertical-align: baseline; font-size: 20px;&quot;&gt;&lt;p dir=&quot;ltr&quot; style=&quot;line-height: 1.38; margin-top: 0pt; margin-bottom: 0pt; font-size: 20px;&quot;&gt;&lt;span style=&quot;background-color: transparent; vertical-align: baseline; font-size: 20px;&quot;&gt;point de vie &amp;lt; dé de vie (en négatif)&amp;nbsp; → mort&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;li dir=&quot;ltr&quot; style=&quot;list-style-type: disc; font-family: arial; background-color: transparent; vertical-align: baseline; font-size: 20px;&quot;&gt;&lt;p dir=&quot;ltr&quot; style=&quot;line-height: 1.38; margin-top: 0pt; margin-bottom: 0pt; font-size: 20px;&quot;&gt;&lt;span style=&quot;background-color: transparent; vertical-align: baseline; font-size: 20px;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b style=&quot;font-size: 20px;&quot;&gt;point de vie initiale&lt;/b&gt;&lt;/font&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt; = dé de vie max + dé de vie(lancée)&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;h1 style=&quot;font-size: 20px;&quot;&gt;&lt;br style=&quot;font-size: 20px;&quot;&gt;&lt;/h1&gt;" vertex="1">
