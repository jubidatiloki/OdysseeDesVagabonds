        <mxCell id="KYm5-SkWlHLZQcgF6zub-1" value="&lt;div&gt;&lt;span style=&quot;font-size: 18px&quot;&gt;&lt;b&gt;Icones des races:&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li style=&quot;text-align: left&quot;&gt;&lt;span style=&quot;font-size: 18px&quot;&gt;&lt;b&gt;Demi-elfe: &lt;/b&gt;demi tete d&#39;elfe, demi tete d&#39;humain&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;text-align: left&quot;&gt;&lt;span style=&quot;font-size: 18px&quot;&gt;&lt;b&gt;demi-orque&lt;/b&gt;: tete d&#39;orque&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;text-align: left&quot;&gt;&lt;span style=&quot;font-size: 18px&quot;&gt;&lt;b&gt;draconien&lt;/b&gt;: tete de dragon&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;text-align: left&quot;&gt;&lt;span style=&quot;font-size: 18px&quot;&gt;&lt;b&gt;elfe-sylvain&lt;/b&gt;: tete d&#39;elfe avec un arc derriere&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;text-align: left&quot;&gt;&lt;span style=&quot;font-size: 18px&quot;&gt;&lt;b&gt;haut-elfe&lt;/b&gt; : tete d&#39;elfe avec un baton derriere&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;text-align: left&quot;&gt;&lt;span style=&quot;font-size: 18px&quot;&gt;&lt;b&gt;gnome&lt;/b&gt;: gnome&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;text-align: left&quot;&gt;&lt;span style=&quot;font-size: 18px&quot;&gt;&lt;b&gt;humain&lt;/b&gt;: humain&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;text-align: left&quot;&gt;&lt;span style=&quot;font-size: 18px&quot;&gt;&lt;b&gt;nain&lt;/b&gt;: nain&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;shadow=1;spacing=15;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="-1480" y="-200" width="350" height="360" as="geometry" />
        </mxCell>
        <mxCell id="o3jithSQE-i6qSpQof-v-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=25;" edge="1" parent="1" source="o3jithSQE-i6qSpQof-v-2" target="o3jithSQE-i6qSpQof-v-3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="o3jithSQE-i6qSpQof-v-2" value="&lt;h1 style=&quot;text-align: center ; font-size: 25px&quot;&gt;&lt;span&gt;Parchemin de magie&lt;/span&gt;&lt;/h1&gt;&lt;h1 style=&quot;font-size: 25px&quot;&gt;&lt;span style=&quot;font-weight: normal&quot;&gt;parchemin avec une formule magique écrite une ou plusieurs fois, chaque lecture de la formule lance le sort et en efface une ligne.&lt;/span&gt;&lt;/h1&gt;&lt;h1 style=&quot;&quot;&gt;&lt;ul style=&quot;&quot;&gt;&lt;li style=&quot;font-size: 25px;&quot;&gt;&lt;span style=&quot;font-weight: normal&quot;&gt;seule utilisation de la magie pour les non mages&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;font-size: 25px;&quot;&gt;&lt;span style=&quot;font-weight: normal&quot;&gt;ne consomme pas de mana&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;font-size: 25px;&quot;&gt;&lt;span style=&quot;font-weight: 400&quot;&gt;nb formule écrite = nb d&#39;utilisation du sort correspondant (1 ligne = 1 sort basiquement)&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;font-size: 25px;&quot;&gt;&lt;span style=&quot;font-weight: 400&quot;&gt;nb de formule possible d&#39;écrire sur un parchemin dépend de la qualité et la taille du parchemin&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/h1&gt;" style="text;html=1;strokeColor=#6c8ebf;fillColor=#dae8fc;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=1;fontSize=25;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="-3010" y="330" width="850" height="440" as="geometry" />
        </mxCell>
        <mxCell id="o3jithSQE-i6qSpQof-v-3" value="&lt;h1 style=&quot;text-align: center&quot;&gt;&lt;span style=&quot;font-size: 25px&quot;&gt;Ecriture d&#39;un parchemin de magie&lt;/span&gt;&lt;/h1&gt;&lt;p&gt;Ecrire un parchemin de magie nécessite :&lt;/p&gt;&lt;p&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;du matériel d&#39;écriture (parchemin, encre, encrier) d&#39;une valeur de 10pa&lt;/li&gt;&lt;li&gt;connaître le sort&lt;/li&gt;&lt;li&gt;utiliser le mana nécessaire au sort pour l&#39;infuser dans la formule&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;/p&gt;" style="text;html=1;strokeColor=#6c8ebf;fillColor=#dae8fc;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=1;fontSize=25;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="-1784" y="280" width="470" height="360" as="geometry" />
        </mxCell>
        <mxCell id="-Ybz_CZe2iiqaO_xYizh-1" value="&lt;h1 style=&quot;text-align: center;&quot;&gt;&amp;nbsp; Résumé &quot;coût&quot; d&#39;une action :&lt;/h1&gt;&lt;h1 style=&quot;font-size: 18px&quot;&gt;&lt;ul&gt;&lt;li style=&quot;&quot;&gt;&lt;span style=&quot;font-weight: normal;&quot;&gt;3 PA par tours&lt;/span&gt;&lt;/li&gt;&lt;ul&gt;&lt;li style=&quot;&quot;&gt;&lt;span style=&quot;font-weight: normal;&quot;&gt;action gratuite = 0PA&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: initial; font-weight: normal;&quot;&gt;action de mouvement = 1PA&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-weight: normal;&quot;&gt;action simple = 2PA&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-weight: normal;&quot;&gt;action complexe = 3 PA&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;/h1&gt;" style="text;html=1;fillColor=#ffe6cc;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=1;shadow=1;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="-250" y="1300" width="370" height="190" as="geometry" />
        </mxCell>
        <mxCell id="vBfNNVceucOeTJYV6Jtg-3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="oufO-iJ00yhSnMANwlUW-1" target="vBfNNVceucOeTJYV6Jtg-1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="vBfNNVceucOeTJYV6Jtg-4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="oufO-iJ00yhSnMANwlUW-1" target="vBfNNVceucOeTJYV6Jtg-2">
          <mxGeometry relative="1" as="geometry" />
