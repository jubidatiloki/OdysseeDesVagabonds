        <mxCell id="jGQSzNbYtyzCzQj3RQxu-0" value="&lt;h1&gt;&amp;nbsp; &amp;nbsp;passif racial&amp;nbsp;&lt;/h1&gt;&lt;p style=&quot;font-size: 16px&quot;&gt;&lt;font style=&quot;font-size: 16px&quot;&gt;Au choix (selon origine):&amp;nbsp;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;font-size: 16px&quot;&gt;&lt;/p&gt;&lt;ul style=&quot;font-size: 16px&quot;&gt;&lt;li&gt;&lt;font style=&quot;font-size: 16px&quot;&gt;humain&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 16px&quot;&gt;elfe-sylvain&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 16px&quot;&gt;haut-elfe&amp;nbsp;&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;/p&gt;" style="text;html=1;strokeColor=#6c8ebf;fillColor=#FFFFFF;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=1;glass=0;shadow=1;" vertex="1" parent="Fy31WUsdD2yVTO4LC-Jr-1">
