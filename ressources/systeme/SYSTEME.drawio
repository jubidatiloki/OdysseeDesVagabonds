        <mxCell id="1E0pnR5yacwigoUuw52S-9" parent="sPp2nEJlRjR283OlNyq3-0" style="text;html=1;strokeColor=#000000;fillColor=#e1d5e7;spacing=15;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=1;shadow=1;labelBackgroundColor=none;fontSize=20;strokeWidth=2;" value="&lt;h1 style=&quot;text-align: center; font-size: 20px;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Chance (CHAN)&lt;/font&gt;&lt;/h1&gt;&lt;div style=&quot;font-size: 20px;&quot;&gt;&lt;span id=&quot;docs-internal-guid-94b7aade-7fff-6a71-2c1a-fca8c3ac20eb&quot; style=&quot;font-size: 20px;&quot;&gt;&lt;span style=&quot;font-family: arial; background-color: transparent; vertical-align: baseline; font-size: 20px;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Représente la chance naturelle et honteuse que RNG jésus porte pour une personne&lt;/font&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;&lt;br style=&quot;font-size: 20px;&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 20px;&quot;&gt;&lt;ul style=&quot;font-size: 20px;&quot;&gt;&lt;li style=&quot;font-size: 20px;&quot;&gt;&lt;span id=&quot;docs-internal-guid-7c462f05-7fff-a3e0-e29e-ce6e2154eb63&quot; style=&quot;font-size: 20px;&quot;&gt;&lt;span style=&quot;font-family: arial; background-color: transparent; vertical-align: baseline; font-size: 20px;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;→ ce qui ne concerne uniquement le pur hasard et non les compétences&lt;/font&gt;&lt;/span&gt;&lt;/span&gt;&lt;br style=&quot;font-size: 20px;&quot;&gt;&lt;/li&gt;&lt;li style=&quot;font-size: 20px;&quot;&gt;→ statistique non roll et défini à 10 par défaut&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;h1 style=&quot;font-size: 20px;&quot;&gt;&lt;br style=&quot;font-size: 20px;&quot;&gt;&lt;/h1&gt;" vertex="1">
