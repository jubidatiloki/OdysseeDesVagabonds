        <mxCell id="NVimz5JA0NgIxIB_Wmtv-447" value="&lt;h1&gt;&lt;span&gt;#1 vol à la tire&lt;/span&gt;&lt;/h1&gt;&lt;h1&gt;&lt;span style=&quot;font-size: 12px ; font-weight: normal&quot;&gt;(passif) +1 / rang au vol à la tire&amp;nbsp; &amp;nbsp;(test de DEX)&lt;/span&gt;&lt;/h1&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-446">
          <mxGeometry y="40" width="200" height="120" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-448" value="&lt;h1&gt;#3 sprint&lt;/h1&gt;&lt;p&gt;(gratuit) 1f/combat, au choix:&amp;nbsp;&lt;br&gt;- 1 action de mouvement en plus dans le tour&amp;nbsp;&lt;br&gt;- 2 actions de mouvements en plus dans le tour (mais pas d&#39;action de mouvement au prochain tour)&lt;br&gt;&lt;br&gt;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-446">
          <mxGeometry y="300" width="200" height="155" as="geometry" />
        </mxCell>
        <mxCell id="JvgE3pmYoANpjuIJ9Q7N-1" value="&lt;h1&gt;#5 Le roi des roublards&lt;/h1&gt;&lt;p&gt;(passif) peut lancer 2d20 pour le vol à la tire et garder le meilleur résultat&lt;/p&gt;&lt;p&gt;(renforcement) sprint: le roublard peut distraire un ennemi dans sa fuite pour permettre aux alliés focus par cette ennemi de bénéficier des mêmes bonus de mouvement que lui&lt;br&gt;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-446">
          <mxGeometry y="640" width="200" height="220" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-449" value="&lt;h1&gt;#2 crochetage&lt;/h1&gt;&lt;p&gt;(passif) +1 / rang pour crocheter + dispose d&#39;un kit d&#39;outil de crochetage&lt;/p&gt;&lt;p&gt;(passif) outils ne cassent plus en cas d&#39;échec critique&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="3210" y="8690" width="200" height="145" as="geometry" />
        </mxCell>
