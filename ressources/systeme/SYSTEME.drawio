        <mxCell id="GnE5Q-5QsUphRtUW_GcG-54" value="&lt;div&gt;&lt;span style=&quot;font-size: 18px&quot;&gt;&lt;b&gt;Potions :&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li style=&quot;text-align: left&quot;&gt;&lt;span style=&quot;font-size: 18px&quot;&gt;&lt;b&gt;fer: &lt;/b&gt;donne +5 DEF pendant 1D6 heures&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;text-align: left&quot;&gt;&lt;span style=&quot;font-size: 18px&quot;&gt;&lt;b&gt;feu grégeois: &lt;/b&gt;inflige 2D6 de feu sur 3m&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;text-align: left&quot;&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;glace condensée: &lt;/b&gt;inflige 1d6 de glace et ralentis les cibles touchées pendant 1d6 tours, sur 3m&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;text-align: left&quot;&gt;&lt;span style=&quot;font-size: 18px&quot;&gt;&lt;b&gt;santé: &lt;/b&gt;donne 1D8 de vie&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;text-align: left&quot;&gt;&lt;b style=&quot;font-size: 18px;&quot;&gt;éclair canalisé&lt;/b&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;: inflige 1D6 de dégâts sur 5m&amp;nbsp;&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;text-align: left&quot;&gt;&lt;span style=&quot;font-size: 18px&quot;&gt;&lt;b&gt;réussite:&lt;/b&gt;&amp;nbsp;donne +3 aux prochains jets pendant 5min&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;text-align: left&quot;&gt;&lt;span style=&quot;font-size: 18px&quot;&gt;&lt;b&gt;poison: &lt;/b&gt;ajoute 1D6 DMG de chaos à l&#39;impact + test de CON difficulté 15 pour résister au poison (1D6 pendant 1D6 tours)&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;text-align: left&quot;&gt;&lt;span style=&quot;font-size: 18px&quot;&gt;&lt;b&gt;magique &lt;/b&gt;(avec l&#39;aide d&#39;un magicien):&amp;nbsp;&lt;/span&gt;&lt;/li&gt;&lt;ul&gt;&lt;li style=&quot;text-align: left&quot;&gt;&lt;span style=&quot;font-size: 18px&quot;&gt;respiration aquatique&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;text-align: left&quot;&gt;&lt;span style=&quot;font-size: 18px&quot;&gt;agrandissement&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;text-align: left&quot;&gt;&lt;span style=&quot;font-size: 18px&quot;&gt;lumière&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;text-align: left&quot;&gt;&lt;span style=&quot;font-size: 18px&quot;&gt;brume&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;text-align: left&quot;&gt;&lt;span style=&quot;font-size: 18px&quot;&gt;bannissement&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;shadow=1;spacing=15;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="-1190" y="225" width="390" height="625" as="geometry" />
        </mxCell>
        <mxCell id="GnE5Q-5QsUphRtUW_GcG-55" value="&lt;div&gt;&lt;span style=&quot;font-size: 18px&quot;&gt;&lt;b&gt;Utilisation d&#39;une potion :&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li style=&quot;text-align: left&quot;&gt;&lt;span style=&quot;font-size: 18px&quot;&gt;&lt;b&gt;boire&lt;/b&gt;: pour soi-même&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;text-align: left&quot;&gt;&lt;span style=&quot;font-size: 18px&quot;&gt;&lt;b&gt;appliquer&lt;/b&gt;: sur une arme ou autre&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;text-align: left&quot;&gt;&lt;span style=&quot;font-size: 18px&quot;&gt;&lt;b&gt;jeter sur une cible (ou au pied d&#39;une cible)&lt;/b&gt;: action d&#39;attaque, test de DEX de lancer&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;text-align: left&quot;&gt;&lt;span style=&quot;font-size: 18px&quot;&gt;&lt;b&gt;jeter au sol&lt;/b&gt;: effet ou non selon la potion (exemple: santé, ca sert a rien vs brume, ca marche)&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;shadow=1;spacing=15;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="-840" y="939" width="340" height="230" as="geometry" />
        </mxCell>
        <mxCell id="GnE5Q-5QsUphRtUW_GcG-84" value="&lt;h1 style=&quot;font-size: 30px&quot;&gt;&lt;font style=&quot;font-size: 30px&quot;&gt;Catégorie d&#39;armure&lt;/font&gt;&lt;/h1&gt;&lt;p style=&quot;text-align: left ; font-size: 18px&quot;&gt;&lt;/p&gt;&lt;ul&gt;&lt;li style=&quot;text-align: left&quot;&gt;casque (1 max)&lt;/li&gt;&lt;li style=&quot;text-align: left&quot;&gt;bouclier (1 max)&lt;/li&gt;&lt;li style=&quot;text-align: left&quot;&gt;armure (1 max)&lt;/li&gt;&lt;li style=&quot;text-align: left&quot;&gt;bijou/accessoire (2 max)&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=#f8cecc;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=1;shadow=1;fontSize=20;align=center;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="670" y="1000" width="220" height="240" as="geometry" />
        </mxCell>
        <mxCell id="GnE5Q-5QsUphRtUW_GcG-85" value="&lt;h1 style=&quot;text-align: center&quot;&gt;Origine du pouvoir (lanceurs de sort) :&lt;/h1&gt;&lt;div style=&quot;font-size: 17px&quot;&gt;&lt;ul&gt;&lt;li&gt;&lt;b&gt;barde / voleur&lt;/b&gt;: appât du gain/spectacles et l&#39;aide d&#39;un mage&lt;/li&gt;&lt;li&gt;&lt;b&gt;druide&lt;/b&gt;: proximité avec la nature / les forces de la nature&lt;/li&gt;&lt;li&gt;&lt;b&gt;magicien&lt;/b&gt;: connaissance &amp;amp; apprentissage&amp;nbsp;&lt;/li&gt;&lt;li&gt;&lt;b&gt;nécromancien&lt;/b&gt;: connaissance &amp;amp; expérience&lt;/li&gt;&lt;li&gt;&lt;b&gt;prêtre&lt;/b&gt;: proximité avec une divinité &amp;amp; croyance&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="text;html=1;fillColor=#dae8fc;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=1;shadow=1;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="-480" y="740" width="400" height="260" as="geometry" />
        </mxCell>
        <mxCell id="GnE5Q-5QsUphRtUW_GcG-86" value="&lt;h1 style=&quot;text-align: center&quot;&gt;&lt;span style=&quot;white-space: pre&quot;&gt;&#x9;&lt;/span&gt;&amp;nbsp;Type de compétence:&amp;nbsp;&amp;nbsp;&lt;/h1&gt;&lt;p&gt;&lt;/p&gt;&lt;ul style=&quot;&quot;&gt;&lt;li style=&quot;font-size: 17px;&quot;&gt;&lt;b&gt;passif &lt;/b&gt;(actif en permanence)&lt;/li&gt;&lt;li style=&quot;font-size: 17px;&quot;&gt;&lt;b style=&quot;background-color: initial;&quot;&gt;actif&lt;/b&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&amp;nbsp;(nécessite d&#39;être utiliser pour profiter des effets)&lt;/span&gt;&lt;br&gt;&lt;/li&gt;&lt;ul style=&quot;&quot;&gt;&lt;li style=&quot;font-size: 17px;&quot;&gt;complexité&lt;/li&gt;&lt;ul style=&quot;font-size: 17px;&quot;&gt;&lt;li&gt;simple (l&#39;équivalent d&#39;une action, donc mouvement possible)&lt;/li&gt;&lt;li&gt;complexe (prend le tour complet)&lt;/li&gt;&lt;li&gt;gratuite (ne &quot;consomme&quot; pas d&#39;action)&lt;/li&gt;&lt;/ul&gt;&lt;li style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 17px;&quot;&gt;type&lt;/span&gt;&lt;/li&gt;&lt;ul&gt;&lt;li style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 17px;&quot;&gt;sort (consomme du mana)&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 17px;&quot;&gt;compétence (ne consomme pas de mana)&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;li&gt;&lt;span style=&quot;font-size: 17px;&quot;&gt;&lt;b&gt;renforcement&lt;/b&gt;: ajoute un effet à une action d&#39;attaque, de mouvement, ... (ex: moine, frappe de ki rang 1 ou moine, déplacement rapide)&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;font-size: 17px;&quot;&gt;&lt;b&gt;amélioration:&amp;nbsp;&lt;/b&gt;améliore une compétence déjà apprise&amp;nbsp;&lt;/li&gt;&lt;li style=&quot;font-size: 17px;&quot;&gt;&lt;b&gt;soutien: &lt;/b&gt;donne une monture, un familier, un objet&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;/p&gt;" style="text;html=1;fillColor=#ffe6cc;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=1;shadow=1;arcSize=16;" vertex="1" parent="1">
          <mxGeometry x="150" y="920" width="430" height="460" as="geometry" />
        </mxCell>
        <mxCell id="GnE5Q-5QsUphRtUW_GcG-87" value="&lt;div style=&quot;font-size: 24px&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 24px&quot;&gt;Esquive&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 17px&quot;&gt;&lt;ul&gt;&lt;li style=&quot;text-align: left&quot;&gt;&lt;span&gt;test d&#39;esquive en opposition au test d&#39;attaque&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;text-align: left&quot;&gt;test = 10 + DEX / 2 + bonus&lt;/li&gt;&lt;li style=&quot;text-align: left&quot;&gt;effet (réussite) = pas de dégats subis (sauf contre indication)&lt;/li&gt;&lt;li style=&quot;text-align: left&quot;&gt;1 esquive par tour&amp;nbsp;&lt;/li&gt;&lt;li style=&quot;text-align: left&quot;&gt;&lt;b&gt;MALUS &lt;/b&gt;contrecoup au prochain tour, pas d&#39;action de mouvement&lt;/li&gt;&lt;ul&gt;&lt;li style=&quot;text-align: left&quot;&gt;renforcement de &lt;b&gt;voleur &lt;/b&gt;(rang 3, voie du bretteur) --&amp;gt; pas de contrecoup si esquive réussi&lt;/li&gt;&lt;li style=&quot;border-color: var(--border-color); text-align: left;&quot;&gt;renforcement de &lt;b&gt;barde &lt;/b&gt;(rang 5, voie de l&#39;acrobate) --&amp;gt; pas de contrecoup&lt;/li&gt;&lt;li style=&quot;text-align: left&quot;&gt;renforcement de &lt;b&gt;moine &lt;/b&gt;(rang 5, voie du ninja) --&amp;gt; pas de contrecoup&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fillColor=#f8cecc;shadow=1;strokeColor=#b85450;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="413" y="-610" width="360" height="490" as="geometry" />
        </mxCell>
