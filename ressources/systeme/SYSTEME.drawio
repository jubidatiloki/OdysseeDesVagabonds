          <mxGeometry x="1851" y="9332.5" width="225" height="120" as="geometry" />
        </mxCell>
        <mxCell id="jRkD0fH0RAPi-SV-QS84-0" value="&lt;h1&gt;#3 Assaut&lt;/h1&gt;&lt;p&gt;(passif) dans une volonté de ne pas se laisser arrêté par des murs ou une porte, le barbare est capable de fabriquer des armes de sièges rudimentaire (mais efficace) comme un bélier avec un tronc d&#39;arbres ou une échelle suffisamment grande et solide pour un siège&lt;/p&gt;&lt;p&gt;(passif) +5 au tests d&#39;attaque et aux dégats contre les batiments ou structures en tout genre&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="100" y="-280" width="200" height="230" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-192" value="&lt;h1&gt;#5 musicien renommé&lt;/h1&gt;&lt;p&gt;(passif) devient un musicien connu, peut se voir proposer des services chez un noble contre rémunération&lt;/p&gt;&lt;p&gt;&lt;span&gt;(renforcement) argent gagné en jouant devient 1d20 + CHAN pièces d&#39;argent&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;span&gt;(passif) dispose de 2 jets au fait de jouer de son instrument&lt;/span&gt;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="2640" y="140" width="200" height="230" as="geometry" />
        </mxCell>
        <mxCell id="exewyG0my6SMBITIkSn--0" value="&lt;h1&gt;#1 début acrobatique&lt;/h1&gt;&lt;p&gt;(passif) +2/ RANG au tests de DEX pour faire des acrobaties, des sauts ou autres pirouette aériennes&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="2890" y="-500" width="200" height="160" as="geometry" />
        </mxCell>
        <mxCell id="exewyG0my6SMBITIkSn--1" value="&lt;h1&gt;#2 attaque sautée&lt;/h1&gt;&lt;p&gt;(actif)(compétence) attaque sautée avec un bonus de +3 AdC et + 1d6 DMG &lt;b&gt;MAIS &lt;/b&gt;impossibilité de se déplacer au prochain tour + si échec de l&#39;attaque, test DEX diff 10 pour se réceptionné et pas être au sol&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="2890" y="-365" width="200" height="185" as="geometry" />
        </mxCell>
        <mxCell id="exewyG0my6SMBITIkSn--3" value="&lt;h1&gt;#5 insaisissable&lt;/h1&gt;&lt;p&gt;(passif) +2 DEX&lt;/p&gt;&lt;p&gt;(renforcement) +1 esquive par tour + pas de malus si esquive réussi&amp;nbsp;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="2890" y="212.5" width="200" height="160" as="geometry" />
        </mxCell>
        <mxCell id="dxOxkdksSXlA5dg17q89-0" value="&lt;h1&gt;#4 TODO&lt;/h1&gt;&lt;p&gt;(renforcement) attaque sauté, plus de malus de déplacement au prochain tour&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="2890" y="45" width="200" height="175" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-271" value="&lt;h1&gt;#5 artilleur vétéran&lt;/h1&gt;&lt;p&gt;peut prendre la tête d&#39;une unité de siège (légitimité / pas de négociation à faire)&lt;/p&gt;&lt;p&gt;+10 tests d&#39;attaque pour toucher une structure avec une arme de siège ou à poudre&lt;/p&gt;&lt;p&gt;+5 tests d&#39;attaque pour toucher une créature (+10 si celle-ci est grande ou plus ou qu&#39;il s&#39;agit d&#39;un très grand groupe d&#39;ennemis)&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="2430" y="3700" width="210" height="260" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-13" value="&lt;h1&gt;#3 rage contrôlée&lt;/h1&gt;&lt;p&gt;(renforcement)&lt;/p&gt;&lt;p&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;2fois / jours&lt;/li&gt;&lt;li&gt;durée --&amp;gt; 1d6 + CON tours&lt;/li&gt;&lt;li&gt;DMG supplémentaires --&amp;gt; +1d8&lt;/li&gt;&lt;li&gt;fait la distinction entre amis et ennemis&lt;/li&gt;&lt;li&gt;arret de la rage --&amp;gt; test CON diff 12&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="410" y="-80" width="230" height="180" as="geometry" />
        </mxCell>
        <mxCell id="uApg3a5MT0ERVzc8dN9p-2" value="&lt;h1&gt;#4 survivant&lt;/h1&gt;&lt;div&gt;(passif) 1 fois / jour, regagne 1d6 PV lorsqu&#39;il tombe à 0PV&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="101" y="-50" width="200" height="110" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-239" value="&lt;h1&gt;#5 tempête menaçante&lt;/h1&gt;&lt;p&gt;(passif) +2 CON&lt;/p&gt;&lt;p&gt;(complexe) Le druide prépare une tempête faite de bourrasque et d&#39;éclairs et de grêle, représente la colère et la puissance de la nature, inflige 4D6 sur une zone de 20m de diamètre&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="2960" y="2030" width="200" height="190" as="geometry" />
        </mxCell>
        <mxCell id="xXE1b60I8q5g-wc-8JuW-0" value="&lt;h1&gt;#5 prédateur&lt;/h1&gt;&lt;div&gt;(passif) +1 CON et +1 FOR&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;(passif) +5 test MEN pour effrayer, faire fuir, intimider&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;(passif) ses poings font désormais des dégâts létaux (1d4 + FOR + CON) et +3 AdC lorsqu&#39;il se bat aux poings&lt;br&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="100" y="70" width="200" height="182.5" as="geometry" />
        </mxCell>
        <mxCell id="A98M8xN_ODcaQkVHmAWa-1" value="&lt;h1&gt;#3 projection mentale&lt;/h1&gt;&lt;p&gt;(actif)(sort) (maintenu) permet de projeter son esprit à l&#39;exterieur de son corps sous forme de boule de lumière intangible qui peut se déplacer 2X plus vite que normalement sans limite de distance (mais limité par le mana), le moine voit à travers sa boule, la boule peut être blessé par la magie (les dégats sont déduits du mana, si plus suffisamment de mana, surplus de dégats --&amp;gt; X2 dégats dans les PV)&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="2340" y="5240" width="200" height="270" as="geometry" />
        </mxCell>
        <mxCell id="MN6eJSND-csa99viL4wL-0" value="&lt;h1&gt;#1 mouvement de shinobi&lt;/h1&gt;&lt;p&gt;(passif) +3 initiative&lt;/p&gt;&lt;p&gt;(passif) si attaque sa cible avant qu&#39;elle agisse, ajoute +1d6 DMG&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="2910" y="5005" width="200" height="135" as="geometry" />
        </mxCell>
        <mxCell id="6S5njVTwADO544-ZtwK--1" value="&lt;h1&gt;#2 l&#39;art du camouflage&lt;/h1&gt;&lt;p&gt;(passif) +5 tests discrétion, camouflage et déplacement silencieux&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="2910" y="5140" width="200" height="165" as="geometry" />
        </mxCell>
        <mxCell id="6S5njVTwADO544-ZtwK--2" value="&lt;h1&gt;#4 déplacement rapide&lt;/h1&gt;&lt;p&gt;(renforcement) action de mouvement --&amp;gt; 15m&lt;/p&gt;&lt;p&gt;(renforcement) peut &lt;b&gt;courir &lt;/b&gt;sur les murs sur une distance max de 15m avant de revenir sur un sol plat (ne peut pas marcher sur les murs)&amp;nbsp;&amp;nbsp;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="2910" y="5480" width="200" height="200" as="geometry" />
        </mxCell>
        <mxCell id="03P-uTl2qIuMWm2uJa1E-0" value="&lt;h1&gt;#5 assaillant fantôme&lt;/h1&gt;&lt;p&gt;(actif) 2 fois par combat, le moine peut effectuer une attaque presque intangible qui traverse les résistance et l&#39;armure adverse&lt;/p&gt;&lt;p&gt;(renforcement) peut lancer jusqu&#39;à 2 shurikens par tour&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="2910" y="5680" width="200" height="200" as="geometry" />
        </mxCell>
        <mxCell id="ihMuWPCweGnJrBux-w4c-1" value="&lt;h1&gt;#3 uppercut&lt;/h1&gt;&lt;p&gt;(actif) puissant coup de poing, 2D6 + FORx2&amp;nbsp;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="3210" y="5380" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="ihMuWPCweGnJrBux-w4c-2" value="&lt;h1&gt;#5 poing de fer&lt;/h1&gt;&lt;p&gt;(renforcement) dégâts coup de poing: 1d6 + FOR --&amp;gt; 1d8 + FOR&lt;/p&gt;&lt;p&gt;(renforcement) dégâts déferlement de coup: 1d6 --&amp;gt; 1d8&lt;/p&gt;&lt;p&gt;(renforcement) dégâts uppercut: 2d6 --&amp;gt; 3d6&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="3210" y="5630" width="200" height="170" as="geometry" />
        </mxCell>
        <mxCell id="ihMuWPCweGnJrBux-w4c-3" value="&lt;h1&gt;#4 lutte&lt;/h1&gt;&lt;p&gt;(actif) peut attraper et immobilier une cible, test d&#39;attaque +5 pour attraper et immobiliser, et test de FOR +5 chaque tour vs test FOR pour que la cible se libère&amp;nbsp;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="3210" y="5490" width="200" height="130" as="geometry" />
        </mxCell>
        <mxCell id="ihMuWPCweGnJrBux-w4c-4" value="&lt;h1&gt;#1 frappe de ki&lt;/h1&gt;&lt;p&gt;(renforcement d&#39;attaque)(sort) permet de renforcer ces attaques en ajoutant son dé de mana aux dégâts&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="2340" y="5005" width="200" height="120" as="geometry" />
        </mxCell>
        <mxCell id="JvgE3pmYoANpjuIJ9Q7N-0" value="&lt;h1&gt;#4 comme chez soi&lt;/h1&gt;&lt;p&gt;(passif) +5 aux tests de DEX, FOR et discrétion pour rentrer ou sortir d&#39;un bâtiment non-autorisé, applicable au voleur + son groupe avec un rapide briefing à celui-ci avant&lt;br&gt;&lt;br&gt;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="3210" y="8990" width="200" height="170" as="geometry" />
        </mxCell>
        <mxCell id="JvgE3pmYoANpjuIJ9Q7N-3" value="&lt;h1&gt;#3 distraction charnelle&lt;/h1&gt;&lt;p&gt;le séducteur peut tenté d&#39;aguicher&amp;nbsp; sa cible (humanoïde obligatoirement) avec une chemise un peu trop ouverte, un petit sourire au coin, un regard, ...&amp;nbsp;pour tenter de la perturber ou de la séduire :&amp;nbsp;&lt;/p&gt;&lt;p&gt;(combat) 1f/combat/cible: (actif) (compétence) pour une action de mouvement, cible: test de INT diff 10 + RANG --&amp;gt; échec = perte tour (cible)&lt;/p&gt;&lt;p&gt;(hors combat) 1f/cible: cible test de INT diff 10 + RANG --&amp;gt; échec = +5 SOC pour le voleur contre son admirateur(rice)&lt;/p&gt;&lt;p&gt;--&amp;gt; réussite = cible test d&#39;INT diff 10 + RANG pour se rendre compte de ce qu&#39;a tenter le voleur, si réussite -5 SOC et -5 MEN pour le voleur contre son NON-admirateur(rice)&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="2370" y="8790" width="220" height="400" as="geometry" />
        </mxCell>
        <mxCell id="L0r-445oCtYEVQolaV1_-0" value="&lt;h1&gt;#4 réseau d&#39;information&lt;/h1&gt;&lt;p&gt;(passif) +5 pour obtenir des informations auprès des personnes dans une ville/village&amp;nbsp;&lt;/p&gt;&lt;p&gt;(renforcement) distraction charnelle: combat ajoute le SOC au test de diff (10 + SOC + RANG)&lt;/p&gt;&lt;p&gt;hors combat: pas de bonus de SOC mais 2 jets d&#39;INT si échec et prise du plus mauvais&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="2370" y="9170" width="220" height="240" as="geometry" />
        </mxCell>
        <mxCell id="L0r-445oCtYEVQolaV1_-1" value="&lt;h1&gt;#1 beau parleur&lt;/h1&gt;&lt;p&gt;(passif) +1 / RANG aux test de SOC lié au fait de baratiner, mentir à qqn&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="2370" y="8565" width="220" height="92.5" as="geometry" />
        </mxCell>
        <mxCell id="3uTkIwCtFAWtZFexeCsW-0" value="&lt;h1&gt;#5 imprévisible&lt;/h1&gt;&lt;p&gt;(passif) 1f/tour, changer d&#39;arme pendant le tour donne +3 AdC, +3AdT&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="101" y="3765" width="200" height="185" as="geometry" />
        </mxCell>
        <mxCell id="3uTkIwCtFAWtZFexeCsW-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="HfUVAWYtu06yr5lZbogK-1" source="3uTkIwCtFAWtZFexeCsW-1" target="NVimz5JA0NgIxIB_Wmtv-264">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="3uTkIwCtFAWtZFexeCsW-1" value="&lt;h1&gt;posture classique par défaut (qui n&#39;a pas de bonus ni de malus)&lt;/h1&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;" style="text;html=1;strokeColor=default;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=1;align=center;verticalAlign=middle;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="5" y="2620" width="225" height="130" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-429" value="&lt;h1&gt;#1 Compagnon animal&lt;/h1&gt;&lt;p&gt;(passif) +5 tests PER&lt;/p&gt;&lt;p&gt;(soutien) animal terrestre (taille max = loup)&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="20" y="8590" width="260" height="140" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-432" value="&lt;h1&gt;#3 compagnon adulte&lt;/h1&gt;&lt;p&gt;(renforcement) buff + peut attaquer&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="20" y="8900" width="260" height="110" as="geometry" />
        </mxCell>
        <mxCell id="Np0-5owIhT9jt2T0PfZd-0" value="&lt;h1&gt;#2 Communication avec les animaux&lt;/h1&gt;&lt;p&gt;(passif) +2 / RANG aux tests de SOC/INT pour comprendre les animaux&lt;/p&gt;&lt;p&gt;(passif) +2 / RANG aux tests de SOC pour se faire comprendre auprès des animaux et essayer de recevoir leurs aide&amp;nbsp;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="20" y="8720" width="260" height="170" as="geometry" />
        </mxCell>
        <mxCell id="Np0-5owIhT9jt2T0PfZd-1" value="&lt;h1&gt;#5 compagnon géant&lt;/h1&gt;&lt;p&gt;(renforcement) buff + peut servir de monture&amp;nbsp;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="20" y="9190" width="260" height="135" as="geometry" />
        </mxCell>
        <mxCell id="Np0-5owIhT9jt2T0PfZd-2" value="&lt;h1&gt;# TODO&lt;/h1&gt;&lt;p&gt;(&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="20" y="9030" width="260" height="110" as="geometry" />
        </mxCell>
        <mxCell id="Np0-5owIhT9jt2T0PfZd-3" value="&lt;h1&gt;#2 proie favorite&lt;/h1&gt;&lt;p&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;(passif) le rodeur est habitué à chasser certaines proies, il gagne +2AdC, +2AdT et +1d4 DM contre celles-ci (proie à définir à la prise de cette compétence)&lt;/span&gt;&lt;br&gt;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="-240" y="8760" width="200" height="130" as="geometry" />
        </mxCell>
        <mxCell id="Np0-5owIhT9jt2T0PfZd-4" value="&lt;h1&gt;#4 Chasseur expérimenté&lt;/h1&gt;&lt;p&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;(renforcement) proie favorite:&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;- 1 proie --&amp;gt; 2 proies&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;- +2 et +1d4DM -&amp;gt; +4 et +1d6DM&lt;/span&gt;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="-240" y="8990" width="200" height="170" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-226" value="&lt;h1&gt;#4 mutation partielle&lt;/h1&gt;&lt;p&gt;change une partie du corps (aile, branchies, patte de lézard pour escalader, patte d&#39;araignées, bras de gorille)&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="2447.5" y="1895" width="220" height="145" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-366" value="&lt;h1&gt;#1 poing de pierre&lt;/h1&gt;&lt;p&gt;(complexe) change son bras en pierre l&#39;espace d&#39;un instant afin d&#39;assener un puissant coup de poing, 2d6 DM PHY&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="-379" y="5162.5" width="220" height="120" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-372" value="&lt;h1&gt;#1 lance de givre&lt;/h1&gt;&lt;p&gt;(actif) lance de givre, qui peut transpercer une cible au rang 4 (et toucher 2 cibles du coup)&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="-149" y="5162.5" width="220" height="120" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-386" value="&lt;h1&gt;#1 éclat des arcanes&lt;/h1&gt;&lt;p&gt;(actif) tire un éclat de magie pure qui ne peut être esquivé infligeant 1d4 DM MAG, renforcé au rang 3 et 5&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="321" y="5160" width="229" height="120" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-378" value="&lt;h1&gt;#1 bourrasque&lt;/h1&gt;&lt;p&gt;(actif) permet de produire une bourrasque repoussant jusqu&#39;à [RANG] + AdM cibles devant le mage, sur une distance max de [RANG] x 2 mètres&amp;nbsp;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="80" y="5160" width="220" height="120" as="geometry" />
        </mxCell>
        <mxCell id="rMcvYHikfScbXa762Qxd-1" value="&lt;h1&gt;#2 rune de défense&lt;/h1&gt;&lt;p&gt;&amp;nbsp;rune sur le dos&lt;/p&gt;&lt;p&gt;classe d&#39;armure +1/ rang&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="2610" y="5220" width="200" height="130" as="geometry" />
        </mxCell>
        <mxCell id="rMcvYHikfScbXa762Qxd-2" value="&lt;h1&gt;#1 rune d&#39;aptitude&lt;/h1&gt;&lt;p&gt;rune sur les bras&lt;/p&gt;&lt;p&gt;au choix: +1 AdC/rang ou +1AdT/rang ou +1 AdM/rang&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="2610" y="5085" width="200" height="135" as="geometry" />
        </mxCell>
        <mxCell id="sJxRrMwBDtDas4KvD53--0" value="&lt;h1&gt;#5 rituel abominable&lt;/h1&gt;&lt;p&gt;invoque une abomination à partir de cadavres ?&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="270" y="7480" width="200" height="150" as="geometry" />
        </mxCell>
