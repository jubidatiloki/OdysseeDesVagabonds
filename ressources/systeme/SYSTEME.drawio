        <mxCell id="NVimz5JA0NgIxIB_Wmtv-221" value="&lt;h1&gt;#5 général des armées&amp;nbsp;&lt;/h1&gt;&lt;p&gt;+2 MEN, capacité de prendre la tête d&#39;une armée, +5 tests de charisme pour mener une troupe au combat&lt;/p&gt;&lt;p&gt;+2 AdC, +1D6 DMG, +3 DEF si combat aux côtés de soldats sous ses ordres&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;glass=0;sketch=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-216">
