        <mxCell id="GnE5Q-5QsUphRtUW_GcG-1" value="&lt;h1 style=&quot;text-align: center&quot;&gt;Gain de points de compétence :&lt;/h1&gt;&lt;p style=&quot;font-size: 17px&quot;&gt;&lt;/p&gt;&lt;ul style=&quot;font-size: 17px&quot;&gt;&lt;li&gt;niveau 1: 3pts&lt;/li&gt;&lt;li&gt;niveau 2: 2pts&lt;/li&gt;&lt;li&gt;niveau 3: 2pts&lt;/li&gt;&lt;li&gt;niveau 4: 2pts&lt;/li&gt;&lt;li&gt;niveau 5: 3pts&lt;/li&gt;&lt;li&gt;niveau 6: 2pts&lt;/li&gt;&lt;li&gt;niveau 7: 2pts&lt;/li&gt;&lt;li&gt;niveau 8: 2pts&lt;/li&gt;&lt;li&gt;niveau 9: 2pts&lt;/li&gt;&lt;li&gt;niveau 10: 4pts&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;/p&gt;&lt;p style=&quot;font-size: 17px&quot;&gt;&lt;br&gt;&lt;/p&gt;" style="text;html=1;fillColor=#ffe6cc;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=1;glass=0;shadow=1;sketch=0;" vertex="1" parent="1">
          <mxGeometry y="320" width="300" height="320" as="geometry" />
        </mxCell>
        <mxCell id="GnE5Q-5QsUphRtUW_GcG-2" value="&lt;h1 style=&quot;text-align: center&quot;&gt;&lt;span style=&quot;white-space: pre&quot;&gt;&#x9;&lt;/span&gt;Coût des rangs :&amp;nbsp;&lt;/h1&gt;&lt;p&gt;&lt;/p&gt;&lt;ul style=&quot;font-size: 17px&quot;&gt;&lt;li&gt;rang 1: 1pt&lt;/li&gt;&lt;li&gt;rang 2: 1pt&lt;/li&gt;&lt;li&gt;rang 3: 2pts&lt;/li&gt;&lt;li&gt;rang 4: 2pts&lt;/li&gt;&lt;li&gt;rang 5: 3pts&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;/p&gt;" style="text;html=1;fillColor=#ffe6cc;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=1;shadow=1;arcSize=16;" vertex="1" parent="1">
          <mxGeometry y="680" width="300" height="200" as="geometry" />
        </mxCell>
        <mxCell id="GnE5Q-5QsUphRtUW_GcG-3" value="&lt;font style=&quot;font-size: 18px&quot;&gt;&lt;b&gt;Le rang pris dans une voie doit être inférieur ou égal au niveau du joueur &lt;/b&gt;(ex: impossible de prendre un rang 3 au niveau 2)&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fillColor=#ffe6cc;shadow=1;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="10" y="160" width="351" height="100" as="geometry" />
        </mxCell>
        <mxCell id="GnE5Q-5QsUphRtUW_GcG-4" value="&lt;h1 style=&quot;text-align: center&quot;&gt;&lt;font style=&quot;font-size: 24px&quot;&gt;&lt;span&gt;Aptitudes / connaissances apprenables (coût = 1pt) :&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;/font&gt;&lt;/h1&gt;&lt;p style=&quot;font-size: 24px&quot;&gt;&lt;/p&gt;&lt;ul style=&quot;font-size: 17px&quot;&gt;&lt;li&gt;&lt;font style=&quot;font-size: 17px&quot;&gt;natation&lt;/font&gt;&lt;/li&gt;&lt;li&gt;équitation&lt;/li&gt;&lt;li&gt;maitrise d&#39;une nouvelle arme&lt;/li&gt;&lt;li&gt;maitrise d&#39;un instrument de musique&lt;/li&gt;&lt;li&gt;nouvelle langue&amp;nbsp;&lt;/li&gt;&lt;li&gt;connaissance dans un domaine, +5 tests liés (exemple: géologie, cartographie, ...)&lt;/li&gt;&lt;li&gt;lire et écrire (non &quot;inné&quot; si INT &amp;lt; 10)&lt;/li&gt;&lt;li&gt;autres (si approbation ou soudoiement du MJ)&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;/p&gt;" style="text;html=1;spacing=10;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=1;fillColor=#ffe6cc;shadow=1;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="420" y="410" width="360" height="400" as="geometry" />
        </mxCell>
        <mxCell id="GnE5Q-5QsUphRtUW_GcG-5" value="&lt;h1 style=&quot;text-align: center&quot;&gt;Types d&#39;attaque:&lt;/h1&gt;&lt;div style=&quot;font-size: 17px&quot;&gt;&lt;ul&gt;&lt;li&gt;&lt;font style=&quot;font-size: 17px&quot;&gt;physique (corps à corps / distance)&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 17px&quot;&gt;magique&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 17px&quot;&gt;élémentaire feu&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 17px&quot;&gt;élémentaire glace&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 17px&quot;&gt;élémentaire foudre&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 17px&quot;&gt;chaos (ignore toute RD)&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;fillColor=#d5e8d4;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=1;glass=0;shadow=1;strokeColor=#82b366;gradientColor=#97d077;" vertex="1" parent="1">
          <mxGeometry x="1024" y="-90" width="340" height="200" as="geometry" />
        </mxCell>
        <mxCell id="GnE5Q-5QsUphRtUW_GcG-6" value="&lt;h1 style=&quot;text-align: center&quot;&gt;Coût en mana (activation):&lt;/h1&gt;&lt;h1 style=&quot;font-size: 17px&quot;&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;font-weight: normal&quot;&gt;&lt;font style=&quot;font-size: 17px&quot;&gt;rang 1: 1pt&lt;/font&gt;&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-weight: normal&quot;&gt;&lt;font style=&quot;font-size: 17px&quot;&gt;&lt;div&gt;rang 2: 3pts&lt;/div&gt;&lt;/font&gt;&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;div&gt;&lt;div style=&quot;font-weight: 400&quot;&gt;&lt;span&gt;rang 3: 6pts&lt;/span&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;&lt;/li&gt;&lt;li&gt;&lt;div&gt;&lt;span&gt;&lt;div style=&quot;font-weight: 400&quot;&gt;rang 4: 10pts&lt;/div&gt;&lt;/span&gt;&lt;/div&gt;&lt;/li&gt;&lt;li&gt;&lt;div&gt;&lt;span style=&quot;font-weight: 400&quot;&gt;rang 5: 15pts&lt;/span&gt;&lt;/div&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/h1&gt;" style="text;html=1;fillColor=#dae8fc;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=1;shadow=1;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="-750" y="340" width="200" height="230" as="geometry" />
        </mxCell>
        <mxCell id="GnE5Q-5QsUphRtUW_GcG-7" value="&lt;h1 style=&quot;text-align: center&quot;&gt;Coût en mana (maintien) :&lt;/h1&gt;&lt;div style=&quot;font-size: 17px&quot;&gt;&lt;ul&gt;&lt;li&gt;&lt;font style=&quot;font-size: 17px&quot;&gt;rang 1: 1pt / tour&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 17px&quot;&gt;rang 2: 2pts / tour&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 17px&quot;&gt;rang 3: 3pts / tour&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 17px&quot;&gt;rang 4: 4pts / tour&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 17px&quot;&gt;rang 5: 5pts / tour&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="text;html=1;fillColor=#dae8fc;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=1;shadow=1;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="-750" y="670" width="200" height="220" as="geometry" />
        </mxCell>
        <mxCell id="GnE5Q-5QsUphRtUW_GcG-8" value="&lt;div style=&quot;text-align: justify&quot;&gt;&lt;b style=&quot;font-size: 18px&quot;&gt;La classe choisie peut augmenter ou diminuer (ou ne pas changer) le dé de vie et le dé de mana&lt;/b&gt;&lt;span style=&quot;font-size: 18px&quot;&gt; du personnage. Le &lt;b&gt;dé minimum est 4&lt;/b&gt;. (exemple: un draconien magicien aura un dé de vie de 8 et un dé de mana de 6).&amp;nbsp;&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;shadow=1;spacing=15;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="-650" y="-220" width="450" height="140" as="geometry" />
        </mxCell>
        <mxCell id="GnE5Q-5QsUphRtUW_GcG-9" value="&lt;h1&gt;&lt;span style=&quot;white-space: pre&quot;&gt;&#x9;&lt;/span&gt;Types de défense:&lt;/h1&gt;&lt;div&gt;&lt;ul style=&quot;font-size: 17px&quot;&gt;&lt;li&gt;&lt;font style=&quot;font-size: 17px&quot;&gt;corps à corps&lt;/font&gt;&lt;/li&gt;&lt;li&gt;distance&lt;/li&gt;&lt;li&gt;magique&lt;/li&gt;&lt;li&gt;élémentaire&lt;/li&gt;&lt;li&gt;esquive, si réussite :&amp;nbsp;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;font-size: 17px&quot;&gt;attaque physique: 0 dégât&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 17px&quot;&gt;attaque magique : dégât / 2&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 17px&quot;&gt;&amp;nbsp;attaque élémentaire : dégât / 2&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;fillColor=#e6d0de;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=1;glass=0;shadow=1;strokeColor=#996185;gradientColor=#d5739d;" vertex="1" parent="1">
