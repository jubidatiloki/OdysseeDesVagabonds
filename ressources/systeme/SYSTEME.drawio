        <mxCell id="BLEH1o2cDtiUHiEx0L1g-0" value="&lt;h1&gt;&amp;nbsp;Légende couleurs :&lt;/h1&gt;&lt;div style=&quot;font-size: 40px&quot;&gt;&lt;ul&gt;&lt;li&gt;&lt;font color=&quot;#ff0000&quot;&gt;&lt;b&gt;physique&lt;/b&gt;&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;b&gt;&lt;font color=&quot;#0066cc&quot; style=&quot;font-size: 40px&quot;&gt;lanceur de sort&lt;/font&gt;&lt;/b&gt;&lt;/li&gt;&lt;li&gt;&lt;font color=&quot;#999999&quot;&gt;&lt;b&gt;physique (mais lanceur de sort mineur possible)&lt;/b&gt;&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;b&gt;&lt;font color=&quot;#009900&quot; style=&quot;font-size: 40px&quot;&gt;hybride&lt;/font&gt;&lt;/b&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=default;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=1;fontSize=30;fontColor=#000000;shadow=1;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
