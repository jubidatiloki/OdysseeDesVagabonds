        <mxCell id="NVimz5JA0NgIxIB_Wmtv-347" value="Voie de [élément choisi]" style="swimlane;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="-139" y="4815" width="200" height="200" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-348" value="Voie de la magie universelle" style="swimlane;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="641" y="4815" width="200" height="1080" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-349" value="&lt;h1&gt;#5 archimage&lt;/h1&gt;&lt;p&gt;(passif) titre d&#39;archimage, +2 INT, +2 AdM&lt;/p&gt;&lt;p&gt;(renforcement) possibilité de lancer 2 sorts dans un même tour (1d12 pour des sorts d&#39;attaque magique et effets / 2 pour les autres sorts, déplacement dans ce tour impossible)&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-348">
          <mxGeometry y="885" width="200" height="175" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-350" value="&lt;h1&gt;#4 téléportation&lt;/h1&gt;&lt;p&gt;(actif) permet de téléporter, le magicien (+ des alliés) sur une grande distance, cout en mana très élevé.&amp;nbsp;&lt;/p&gt;&lt;p&gt;cout en mana = N * D&lt;/p&gt;&lt;p&gt;&lt;span&gt;N = nombre de personnes&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span&gt;D = distance (km)&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-348">
          <mxGeometry y="690" width="200" height="195" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-351" value="&lt;h1&gt;#2 cercle de protection&lt;/h1&gt;&lt;p&gt;(actif) créer un cercle pouvant contenir jusqu&#39;à INT personnes, pour qui il donne +3 à la DEF MAG aux autres joueurs, le cercle dure INT + 1d4 tours et le sort est brisé si le magicien en sort. au rang 4, le mage peut intercepter les sorts adverses (visant ses alliés dans le cercle), et utiliser sa défense magique en conséquence&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-348">
          <mxGeometry y="185" width="200" height="220" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-352" value="&lt;h1&gt;#1 savoir magique&lt;/h1&gt;&lt;p&gt;(passif) +1 / RANG aux tests liés aux connaissance et savoirs occultes ou liés à la magie&lt;/p&gt;&lt;p&gt;accès aux sort de rang 0&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-348">
          <mxGeometry y="40" width="200" height="170" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-353" value="&lt;h1&gt;#3 transfert de mana&lt;/h1&gt;&lt;p&gt;(renforcement) permet de transférer le mana d&#39;une personne à une autre, si consentante: action simple, sinon : action d&#39;attaque magique, débit de transfert: DM du magicien par action&amp;nbsp;&lt;/p&gt;&lt;p&gt;(passif) permet de dépasser son maximum de mana pendant une faible période de temps, sans subir d&#39;overdose magique (durée dépassement =&amp;nbsp; INT * 2 min)&amp;nbsp;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-348">
          <mxGeometry y="405" width="200" height="265" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-354" value="Voie de la lumière" style="swimlane;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="941" y="4815" width="210" height="810" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-355" value="&lt;h1&gt;#4 armure du zenith&lt;/h1&gt;&lt;p&gt;(renforcement) l&#39;orbe de lumière dure maintenant INT + RANG tours&lt;br&gt;(actif) bouclier 20 + INT * RANG&lt;/p&gt;&lt;p&gt;&lt;b&gt;TODO&lt;/b&gt;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-354">
          <mxGeometry y="520" width="210" height="150" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-356" value="&lt;h1&gt;#5 bannissement&lt;/h1&gt;&lt;p&gt;(passif) +2 INT, +2AdM&lt;/p&gt;&lt;p&gt;(actif)&amp;nbsp; lève la conjuration d&#39;une entité invoqué (cout = cout du rang du sort d&#39;invocation)&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-354">
          <mxGeometry y="670" width="210" height="140" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-357" value="&lt;h1&gt;#3 perception vitale&lt;/h1&gt;&lt;p&gt;(actif) permet de percevoir le nombre et une direction approximative des entités vivantes autour du mage (jusqu&#39;à max RANG * 10 mètres)&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-354">
          <mxGeometry y="350" width="210" height="160" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-358" value="Voie du feu" style="swimlane;startSize=23;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="-609" y="5125" width="220" height="710" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-359" value="&lt;h1&gt;#2 esprit du Phoenix&amp;nbsp;&lt;/h1&gt;&lt;div&gt;(passif) Le mage gagne petit à petit une résistance au dégâts de feu, cela s&#39;illustre par des tatouages magiques rouge sur son corps. +1 RD feu / rang&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-358">
          <mxGeometry y="165" width="220" height="145" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-360" value="&lt;h1&gt;#1 boule de feu&lt;/h1&gt;&lt;p&gt;(actif) canalise une boule de feu pouvant être projeté jusqu&#39;à 20m, inflige 1d6 DM FEU (le sort peut être modulé au rang suivant afin de faire [RAND]d6 dmg (avec le cout en mana adapté au rang)&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-358">
          <mxGeometry y="25" width="220" height="145" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-361" value="&lt;h1&gt;#3 mur de flamme&lt;/h1&gt;&lt;p&gt;(actif) crée un mur de flamme jusqu&#39;à 1d8 + INT mètres de large pendant 1d6 + INT tours, qui inflige 3d6 de feu à ceux qui veulent le traverser&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-358">
          <mxGeometry y="310" width="220" height="120" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-362" value="&lt;h1&gt;&lt;span&gt;#4 controle du feu&lt;/span&gt;&lt;/h1&gt;&lt;div&gt;&lt;span&gt;(renforcement) pour intensifier, éteindre, donner une forme (controle minimal (cf doigt briquet, a le cout en mana d&#39;un rang 1) permet de donner une forme au mur de flamme&lt;/span&gt;&lt;/div&gt;&lt;h1&gt;&lt;br&gt;&lt;/h1&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-358">
          <mxGeometry y="430" width="220" height="130" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-363" value="&lt;h1&gt;#5 élémentaire de feu&lt;/h1&gt;&lt;p&gt;(actif) invoquer ou se transformer en élémentaire&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-358">
          <mxGeometry y="560" width="220" height="120" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-364" value="Voie de la terre" style="swimlane;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="-379" y="5125" width="220" height="710" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-365" value="&lt;h1&gt;#2 esprit de Gaia&lt;/h1&gt;&lt;div&gt;(passif) Le mage gagne petit à petit une résistance au dégâts physique, cela s&#39;illustre par des tatouages magiques vert sur son corps. +1 RD physique / rang&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-364">
          <mxGeometry y="175" width="220" height="135" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-367" value="&lt;h1&gt;#4 sens tellurique&lt;/h1&gt;&lt;p&gt;(renforcement) permet de détecter tout mouvement sur et sous le sol, détection sur 20m / min passé à se concentrer dessus&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-364">
          <mxGeometry y="430" width="220" height="120" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-368" value="&lt;h1&gt;#5 élémentaire de pierre&lt;/h1&gt;&lt;p&gt;(actif) invoquer ou se transformer en élémentaire&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-364">
          <mxGeometry y="560" width="220" height="120" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-369" value="&lt;h1&gt;#3 prison terrestre&lt;/h1&gt;&lt;p&gt;(actif) ouvre le sol sous les pieds d&#39;une cible pour l&#39;emprisonner (taille moyenne max, rang 4 taille grande max)&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-364">
          <mxGeometry y="310" width="220" height="120" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-370" value="Voie de l&#39;eau" style="swimlane;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="-149" y="5125" width="220" height="710" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-371" value="&lt;h1&gt;#2 esprit de Neptune&lt;/h1&gt;&lt;div&gt;(passif) Le mage gagne petit à petit une résistance au dégâts de glace, cela s&#39;illustre par des tatouages magiques bleus sur son corps. +1 RD glace / rang&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-370">
          <mxGeometry y="155" width="220" height="155" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-373" value="&lt;h1&gt;#3 soutien marin&lt;/h1&gt;&lt;p&gt;(passif) peut respirer sous l&#39;eau 10min sans gêne (puis applique la gestion de la respiration sous l&#39;eau normalement)&lt;/p&gt;&lt;p&gt;(actif) peut, en lançant un sort, permettre à lui-même ou qn d&#39;autre d&#39;en profiter&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-370">
          <mxGeometry y="290" width="220" height="150" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-374" value="&lt;h1&gt;#5 élémentaire de glace&lt;/h1&gt;&lt;p&gt;(actif) invoquer ou se transformer en élémentaire&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-370">
          <mxGeometry y="560" width="220" height="120" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-375" value="&lt;h1&gt;#4 prison aqueuse&lt;/h1&gt;&lt;p&gt;(actif) créer une sphère d&#39;eau autour d&#39;une cible afin de la blesser/noyer ou au contraire de la vider d&#39;eau&amp;nbsp;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-370">
          <mxGeometry y="440" width="220" height="120" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-376" value="Voie de l&#39;air" style="swimlane;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="81" y="5125" width="220" height="710" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-377" value="&lt;h1&gt;#1 esprit de Zéphyr&lt;/h1&gt;&lt;div&gt;(passif) Le mage gagne petit à petit une résistance au dégâts de foudre, cela s&#39;illustre par des tatouages magiques blancs sur son corps. +1 RD foudre / rang&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-376">
          <mxGeometry y="155" width="220" height="155" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-379" value="&lt;h1&gt;#3 mur d&#39;air&lt;/h1&gt;&lt;p&gt;(actif) dévie les projectiles qui arrive dans la direction du mage et de ses alliés proches de lui, +10 de DEF contre les projectiles (magique ou physique)&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-376">
          <mxGeometry y="305" width="220" height="120" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-380" value="&lt;h1&gt;#4 chaine d&#39;éclairs&lt;/h1&gt;&lt;p&gt;(actif) projette un éclair sur un ennemi, qui peut se projeter sur jusqu&#39;à 3 autres cibles (jet d&#39;attaques magiques pour les suivants avec malus de -3 à chaque rebond et dégats réduits de 2 par nouvelles cibles)&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-376">
          <mxGeometry y="415" width="220" height="175" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-381" value="&lt;h1&gt;#5 élémentaire d&#39;air&lt;/h1&gt;&lt;p&gt;(actif) invoquer ou se transformer en élémentaire&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-376">
          <mxGeometry y="590" width="220" height="120" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-382" value="Voie des arcanes" style="swimlane;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="321" y="5125" width="230" height="740" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-383" value="&lt;h1&gt;#2 esprit arcanique&lt;/h1&gt;&lt;div&gt;(passif) Le mage gagne petit à petit une résistance au dégâts à la magie, cela s&#39;illustre par des tatouages magiques violets sur son corps. +1 RD magique/ rang&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-382">
          <mxGeometry y="155" width="220" height="175" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-384" value="&lt;h1&gt;#5 déchainement des arcanes&lt;/h1&gt;&lt;p&gt;(actif) déchainement&lt;span&gt;&amp;nbsp;de puissance arcanique qui provoque une explosion désintégrant&amp;nbsp;ce qu&#39;elle touche, 5d6 + INT DMG&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span&gt;(renforcement) éclat des arcanes, 3d4 + AdM DMG&lt;/span&gt;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-382">
          <mxGeometry y="550" width="230" height="190" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-385" value="&lt;h1&gt;#4 artéfact magique&lt;/h1&gt;&lt;p&gt;(renforcement)&amp;nbsp;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-382">
          <mxGeometry y="440" width="230" height="120" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-387" value="&lt;h1&gt;#3 agrandissement&lt;/h1&gt;&lt;p&gt;(actif) accroit la taille d&#39;un allié (ou lui-même)&lt;/p&gt;&lt;p&gt;(renforcement) éclat des arcanes, 2D4 DM&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-382">
          <mxGeometry y="320" width="230" height="120" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-388" value="&lt;h1&gt;#1 orbe de lumière&lt;/h1&gt;&lt;p&gt;(actif) crée un orbe de lumière qui flotte près du magicien pendant INT tours&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="941" y="4855" width="200" height="135" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-389" value="&lt;h1&gt;#2 lueur scintillante&lt;/h1&gt;&lt;p&gt;(actif) aveugler ou dissiper des ténèbres&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="941" y="5005" width="209" height="120" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-390" value="Voie du ki" style="swimlane;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="2340" y="4975" width="200" height="860" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-393" value="&lt;h1&gt;#5 mental d&#39;acier&lt;/h1&gt;&lt;p&gt;(renforcement) augmentation du dé de mana&lt;/p&gt;&lt;p&gt;(passif) devient immunisé aux attaques magique de son esprit ou de ses sens (mind control, fear magique, ...)&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-390">
          <mxGeometry y="675" width="200" height="185" as="geometry" />
        </mxCell>
        <mxCell id="A98M8xN_ODcaQkVHmAWa-0" value="&lt;h1&gt;#4 kenn-do-ha&lt;/h1&gt;&lt;p&gt;(complexe)(sort) attaque magique, qui projette une boule d&#39;énergie , venant du ki du moine, en ligne droite qui inflige 4 DM (dé de mana) (peut transpercer mais perd 1DM par cible traversé)&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-390">
          <mxGeometry y="535" width="200" height="165" as="geometry" />
        </mxCell>
        <mxCell id="boHHZTjjZpxjR2tb-aG3-4" value="&lt;h1&gt;#2 méditation&lt;/h1&gt;&lt;p&gt;(complexe) peut méditer pendant une petite heure pour regagner 1DM mana&amp;nbsp;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-390">
          <mxGeometry y="145" width="200" height="120" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-391" value="Voie du poing" style="swimlane;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="3210" y="4975" width="200" height="845" as="geometry" />
        </mxCell>
        <mxCell id="vC0dzxqm7D2RYbgnr9Ld-0" value="&lt;h1&gt;#1 pugilat&lt;/h1&gt;&lt;p&gt;(amélioration) coup de poing peut être considérer comme dégâts létaux (selon ce que veut le moine)&lt;/p&gt;&lt;p&gt;(amélioration) dégâts coup de poing: 1d4 + FOR --&amp;gt; 1d6 + FOR DM&lt;/p&gt;&lt;p&gt;(passif) +RANG AdC pour les attaques à main nus&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-391">
          <mxGeometry y="20" width="200" height="210" as="geometry" />
        </mxCell>
        <mxCell id="ihMuWPCweGnJrBux-w4c-0" value="&lt;h1&gt;#2 déferlement de coups&lt;/h1&gt;&lt;p&gt;(complexe) possibilité d&#39;effectuer RANG coup de poings à une cible (FOR non appliqué au dégâts, chaque coup = 1 jet d&#39;attaque)&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-391">
          <mxGeometry y="235" width="200" height="180" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-392" value="Voie des runes" style="swimlane;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="2610" y="4975" width="220" height="992.5" as="geometry" />
        </mxCell>
        <mxCell id="rMcvYHikfScbXa762Qxd-0" value="&lt;div&gt;&lt;br&gt;&lt;/div&gt;Peut activer jusqu&#39;à 1 rune. Le nombre de rune activable passe à 2 au rang 4. L’activation/désactivation d’une (ou plusieurs) runes demande 5 min de concentration." style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-392">
          <mxGeometry y="25" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="rMcvYHikfScbXa762Qxd-4" value="&lt;h1&gt;#4 rune de vitesse&lt;/h1&gt;&lt;p&gt;rune sur les jambes&lt;/p&gt;&lt;p&gt;dynamise les muscles du porteur, lui apportant une meilleur fluidité dans ses mouvements, cela fatigue cependant un peu plus le porteur, +5 d’iniative, +5 aux tests de vitesse et dexterité (courses, nage (si sais nager), …) ET -3 aux tests de CON&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-392">
          <mxGeometry y="565" width="200" height="225" as="geometry" />
        </mxCell>
        <mxCell id="rMcvYHikfScbXa762Qxd-3" value="&lt;h1&gt;#3 rune de précision&lt;/h1&gt;&lt;p&gt;rune présentes sur les mains et poignées&lt;/p&gt;&lt;p&gt;attaque crit +2 ET échec critique sur 2 (donc 1 ou 2 sur un dé 20 = échec critique et par défaut: 18, 19, 20 = réussite critique)&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-392">
          <mxGeometry y="375" width="200" height="185" as="geometry" />
        </mxCell>
        <mxCell id="rMcvYHikfScbXa762Qxd-5" value="&lt;h1&gt;#5 rune du berzerker&lt;/h1&gt;&lt;p&gt;rune réalisé sur les épaules&lt;/p&gt;&lt;p&gt;autorise une attaque supplémentaire par tour mais fait perdre 3 de classe d&#39;armure tant qu&#39;elle est active (si la rune de défense est active, ca donne +2CA avec les 2 runes)&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-392">
          <mxGeometry y="790" width="220" height="202.5" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-394" value="Voie du ninja" style="swimlane;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="2910" y="4975" width="200" height="915" as="geometry" />
        </mxCell>
        <mxCell id="6S5njVTwADO544-ZtwK--0" value="&lt;h1&gt;#3 lancer de shuriken&lt;/h1&gt;&lt;p&gt;(gratuit) une fois par tour, le moine peut lancer gratuitement un shuriken à une cible à 10m de portée (pas au CaC), DMG = 1d4+DEX&lt;/p&gt;&lt;p&gt;(amélioration) le bonus d&#39;initiative passe à +5&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-394">
          <mxGeometry y="297.5" width="200" height="202.5" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-395" value="Voie de la mort" style="swimlane;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="-290" y="6700" width="200" height="760" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-396" value="&lt;h1&gt;#3 récits du passé&lt;/h1&gt;&lt;p&gt;(actif + maintien) permet d&#39;appeler un fantôme à partir d&#39;un cadavre pour lui parler&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-395">
          <mxGeometry y="330" width="200" height="120" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-397" value="&lt;h1&gt;#4 afflux mortuaire&lt;/h1&gt;&lt;p&gt;Projette un vague d’énergie funèbre qui rend 3D6 + INT à un être non vivant ou démoniaque ou inflige 3D6 + INT à une créature vivante non démoniaque.&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;glass=0;sketch=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-395">
          <mxGeometry y="470" width="200" height="150" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-398" value="&lt;h1&gt;#2 Siphon d&#39;âme&lt;/h1&gt;&lt;p&gt;(renforcement) lorsque qu&#39;une créature meurt près du nécromancien, son âme s&#39;échappe et est visible par ce dernier. Il peut pour une action de mouvement, absorber son ame pour se soigner, le heal dépend de la taille de la créature&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-395">
          <mxGeometry y="140" width="200" height="180" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-399" value="&lt;h1&gt;#1 TODO&amp;nbsp;&lt;/h1&gt;&lt;p&gt;TODO&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-395">
          <mxGeometry y="20" width="200" height="170" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-400" value="&lt;h1&gt;#5 présage de mort&lt;/h1&gt;&lt;p&gt;TODO&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-395">
          <mxGeometry y="620" width="200" height="160" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-401" value="Voie des morts vivants" style="swimlane;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry y="6700" width="200" height="760" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-402" value="&lt;h1&gt;#1 perception nécrotique&lt;/h1&gt;&lt;p&gt;permet de percevoir le nombre et une direction grossière des créatures mortes autour du nécromancien (jusqu&#39;à max RANG * 10 mètres)&lt;br&gt;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-401">
          <mxGeometry y="30" width="200" height="150" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-403" value="&lt;h1&gt;#2 fidèle serviteur&amp;nbsp;&lt;/h1&gt;&lt;p&gt;(actif) relever un cadavre de taille moyenne, temporaire&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-401">
          <mxGeometry y="180" width="200" height="170" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-404" value="&lt;h1&gt;#4 fidèle et puissant serviteur&lt;/h1&gt;&lt;p&gt;(actif) relever un cadavre de taille grande&lt;/p&gt;&lt;p&gt;(renforcement) invocation permanent possible (cf le google doc)&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-401">
          <mxGeometry y="420" width="200" height="190" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-405" value="&lt;h1&gt;#5 requiem&lt;/h1&gt;&lt;p&gt;(complexe) entonne un chant qui ramène les morts à la vie afin de se constituer une petite armée de morts vivants&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-401">
          <mxGeometry y="630" width="200" height="120" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-406" value="&lt;h1&gt;#3 TODO&lt;/h1&gt;&lt;p&gt;TODO&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-401">
          <mxGeometry y="310" width="200" height="110" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-407" value="Voie de l&#39;invocation" style="swimlane;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="-590" y="6705" width="200" height="735" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-408" value="&lt;h1&gt;#2 ténèbres&lt;/h1&gt;&lt;p&gt;invoque un brouillard de ténèbres, qui empêche les autres(alliés compris) de voir (sauf lanceur) ou dissipe une lumière magique&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-407">
          <mxGeometry y="155" width="200" height="120" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-409" value="&lt;h1&gt;#1 famillier&lt;/h1&gt;&lt;p&gt;TODO&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-407">
          <mxGeometry y="25" width="200" height="170" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-410" value="&lt;h1&gt;#3 TODO&lt;/h1&gt;&lt;p&gt;TODO&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-407">
          <mxGeometry y="285" width="200" height="170" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-411" value="&lt;h1&gt;#4 TODO&lt;/h1&gt;&lt;p&gt;TODO&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-407">
          <mxGeometry y="415" width="200" height="170" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-412" value="&lt;h1&gt;#5 Démon&lt;/h1&gt;&lt;p&gt;invocation un démon&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-407">
          <mxGeometry y="565" width="200" height="170" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-414" value="Voie des rituels" style="swimlane;rounded=0;shadow=0;fillColor=#ffffff;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="270" y="6700" width="200" height="930" as="geometry" />
        </mxCell>
        <mxCell id="boHHZTjjZpxjR2tb-aG3-0" value="&lt;h1&gt;#2 rituel des os&lt;/h1&gt;&lt;p&gt;(actif) hors combat, réalise un rituel lors duquel, le nécromancien utilise des os (humains ou d&#39;animaux) pour renforcer les os d&#39;une personnes ou créature lui conférant 2 RD physique pour la journée&lt;br&gt;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-414">
          <mxGeometry y="215" width="200" height="150" as="geometry" />
        </mxCell>
        <mxCell id="boHHZTjjZpxjR2tb-aG3-3" value="&lt;h1&gt;#3 rituel sanguinaire&lt;/h1&gt;&lt;p&gt;(actif) hors combat, réalise un rituel lors duquel, le nécromancien utilise 1d10 PV (plutôt que du mana) pour imposer une marque sur une arme. La prochaine attaque avec laquelle cette arme frappera fera exploser la marque de sang et infligera 2d6 + INT DMG magique (1d6 supplémentaire si le rituel est fait sur l&#39;épée sanguinaire)&lt;br&gt;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-414">
          <mxGeometry y="360" width="200" height="230" as="geometry" />
        </mxCell>
        <mxCell id="boHHZTjjZpxjR2tb-aG3-1" value="&lt;h1&gt;#4 rituel de la lune&lt;/h1&gt;&lt;p&gt;(actif) hors combat, de nuit en extérieur, coute du mana, le nécromancien utilise un surface réfléchissante afin d&#39;essayer de trouver une personne ou un objet, test d&#39;AdM diff selon la difficulté à trouver la personne ou l&#39;objet de 10 à 30 (a voir avec le MJ)&lt;br&gt;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-414">
          <mxGeometry y="580" width="200" height="210" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-415" value="&lt;h1&gt;il n&#39;y a pas d&#39;innocent, simplement des degrés de culpabilité&lt;/h1&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="3280" y="6640" width="330" height="120" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-416" value="Voie des soins" style="swimlane;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="2405" y="6820" width="200" height="650" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-417" value="Voie du paladin" style="swimlane;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="2665" y="6820" width="205" height="860" as="geometry" />
        </mxCell>
        <mxCell id="Ey6meIt2XCCsibth4jBo-0" value="&lt;h1&gt;#3 lien vital&amp;nbsp;&lt;/h1&gt;&lt;p&gt;(renforcement) bénédiction --&amp;gt; +2 et sort de rang 2&lt;br&gt;&lt;br&gt;(actif) lie un allié et le pretre, pour que ce dernier prennent les dégâts subi par son allié à sa place, dure INT tours&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-417">
          <mxGeometry x="2.5" y="325" width="200" height="155" as="geometry" />
        </mxCell>
        <mxCell id="Ey6meIt2XCCsibth4jBo-2" value="&lt;h1&gt;#4 glas de soutien?&lt;/h1&gt;&lt;p&gt;(actif) soigne jusqu&#39;à INT+1 cibles jusqu&#39;à 20m autour du prêtre de 1D10 PV (peut etre maintenu pour soigné chaque tour)&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-417">
          <mxGeometry x="-2.5" y="477.5" width="202.5" height="162.5" as="geometry" />
        </mxCell>
        <mxCell id="70wYN6jfj6vNA13E11a1-2" value="&lt;h1&gt;#5 TODO&amp;nbsp;&lt;/h1&gt;&lt;p&gt;(renforcement) lien vital peut se faire dans l&#39;autre sens, test d&#39;attaque magique si lancé sur un ennemi&amp;nbsp;&lt;br&gt;(TODO)&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-417">
          <mxGeometry y="650" width="200" height="155" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-418" value="Voie du divin" style="swimlane;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="2935" y="6820" width="204" height="780" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-419" value="&lt;h1&gt;#4 Courroux céleste&lt;/h1&gt;&lt;p&gt;(actif) La cible est frappé par un éclair (ou autre) d&#39;une violence telle qu&#39;elle ne laisse nul doute au fait d&#39;etre de nature divine, test d&#39;attaque magique 1D12 -&amp;gt; 4D6 dégats de chaos (si esquive réussi, DMG / 2, peu importe les tentatives, personne n&#39;échappe à la colère divine)&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-418">
          <mxGeometry y="308" width="200" height="210" as="geometry" />
        </mxCell>
        <mxCell id="PRqGWWr7hAl_Sj7m-B9w-3" value="&lt;h1&gt;#5 Justice divine&lt;/h1&gt;&lt;p&gt;(soutien) obtient une arme d&#39;énergie divine pure, celle-ci se trouve dans un autre plan, &quot;l&#39;attraper&quot; (ou la &quot;ranger&quot;) coute une action de mouvement,&amp;nbsp; 2D6 + FOR + INT DMG de chaos, consomme 5pt de mana par attaque, si qn d&#39;autre que le pretre touche l&#39;arme, il subit 1D6 de dégat de chaos. (si plus suffisamment de mana, l&#39;arme est rappelé dans son plan d&#39;origine)&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-418">
          <mxGeometry x="2" y="518" width="200" height="260" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-423" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=30;fontColor=#000000;" edge="1" parent="HfUVAWYtu06yr5lZbogK-1" source="NVimz5JA0NgIxIB_Wmtv-420" target="NVimz5JA0NgIxIB_Wmtv-415">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-420" value="Voie de l&#39;inquisiteur" style="swimlane;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="3185" y="6820" width="200" height="770" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-421" value="&lt;h1&gt;#2 paroles impies&lt;/h1&gt;&lt;p&gt;(actif) dans sa lutte contre les créatures impies, l&#39;inquisiteur est parfois contraint d&#39;employer le mal contre le mal, il débite un sermon supposé interdit qui immobilise INT ennemis dans un rayon de 10m jusqu&#39;au prochain tour (action de CON diff 10 + INT pour s&#39;en libérer directement)&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-420">
          <mxGeometry y="150" width="200" height="220" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-422" value="&lt;h1&gt;#3 dissipation&lt;/h1&gt;&lt;p&gt;(actif)(sort) permet de dissiper un sort ou une transformation mineur (ne fonctionne que sur les sort de rang 3 ou moins)&amp;nbsp;&lt;span style=&quot;background-color: initial;&quot;&gt;(cout dissipation = cout du sort)&lt;/span&gt;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-420">
          <mxGeometry y="360" width="200" height="120" as="geometry" />
        </mxCell>
        <mxCell id="VE-AA93kvBegw-qPm-UM-4" value="&lt;h1&gt;#5 inquisition&lt;/h1&gt;&lt;p&gt;(passif) +2 INT&lt;/p&gt;&lt;p&gt;(renforcement) parole impies --&amp;gt; diff = &lt;b&gt;15 &lt;/b&gt;+ INT&lt;/p&gt;&lt;p&gt;(renforcement) dissipation: possibilité de dissiper un sort de rang 4 et 5 également&amp;nbsp;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-420">
          <mxGeometry y="590" width="200" height="190" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-425" value="Voie de l&#39;archer" style="swimlane;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="-490" y="8565" width="200" height="760" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-426" value="&lt;h1&gt;#3 Fuite stratégique&lt;/h1&gt;&lt;p&gt;(gratuit) une fois par combat, action de mouvement supplémentaire pour fuir ses ennemis&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-425">
          <mxGeometry y="245" width="200" height="150" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-427" value="&lt;h1&gt;#1 précision&lt;/h1&gt;&lt;p&gt;(passif) +1 AdT / rang&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-425">
          <mxGeometry y="45" width="200" height="150" as="geometry" />
        </mxCell>
        <mxCell id="2rxSsDhHAnS-eIEXSBTq-3" value="&lt;h1&gt;#2 Visée&lt;/h1&gt;&lt;p&gt;(complexe) en n&#39;utilisant pas d&#39;action de mouvement durant son tour, le rodeur gagne un avantage à son test d&#39;attaque à distance&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-425">
          <mxGeometry y="123" width="200" height="117" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-428" value="Voie du chasseur" style="swimlane;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="-240" y="8565" width="200" height="760" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-430" value="&lt;h1&gt;#1 pistage&lt;/h1&gt;&lt;p&gt;(passif) +2 / RANG aux tests de PER pour pister un animal, suivre une cible, suivre des traces&lt;/p&gt;&lt;p&gt;(passif) +2 / RANG aux test d&#39;INT pour comprendre les mouvements à partir de traces de pas, de ce qu&#39;il s&#39;est passé&amp;nbsp;&amp;nbsp;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-428">
          <mxGeometry y="25" width="200" height="165" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-433" value="&lt;h1&gt;#5 Chasseur de gros gibier&lt;/h1&gt;&lt;p&gt;+ 2D6 DMG contre les ennemis de tailles grands ou plus&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-428">
          <mxGeometry y="600" width="200" height="160" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-434" value="Voie des animaux" style="swimlane;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="20" y="8565" width="260" height="760" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-435" value="Voie du trappeur" style="swimlane;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="300" y="8565" width="201" height="750" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-431" value="&lt;h1&gt;#2 piège&lt;/h1&gt;&lt;p&gt;(actif) TODO&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-435">
          <mxGeometry y="185" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="2rxSsDhHAnS-eIEXSBTq-1" value="&lt;h1&gt;#4 survivaliste&lt;/h1&gt;&lt;p&gt;(passif) habitué à être dans la foret, le rodeur sait comment se nourrir et se protéger des intempéries, gagne un avantage et +5 aux tests pour trouver/fabriquer un abri de fortune et à manger&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-435">
          <mxGeometry x="1" y="455" width="200" height="145" as="geometry" />
        </mxCell>
        <mxCell id="Np0-5owIhT9jt2T0PfZd-5" value="&lt;h1&gt;#4 TODO&lt;/h1&gt;&lt;p&gt;(&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-435">
          <mxGeometry y="295" width="200" height="135" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-436" value="Voie de l&#39;assassin" style="swimlane;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="2640" y="8530" width="220" height="940" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-437" value="&lt;h1&gt;#1 attaque dans le dos&lt;/h1&gt;&lt;p&gt;(renforcement) +1D4 /RANG DMG si attaque dans le dos&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-436">
          <mxGeometry y="35" width="220" height="150" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-438" value="&lt;h1&gt;#2 fourberie&lt;/h1&gt;&lt;p&gt;(renforcement) le voleur peut, avec un jet de DISCRETION se cacher dans la pénombre, un recoin, derrière un pillier pour que l&#39;enemi perde sa trace momentanément et l&#39;oblige à faire un test de PER pour le trouver et ne pas interrompre son action pour ce tour (fonctionne uniquement si le voleur n&#39;est pas la seule cible de son ennemi)&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-436">
          <mxGeometry y="150" width="220" height="180" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-439" value="&lt;h1&gt;#3 coupe-jarret&lt;/h1&gt;&lt;p&gt;(action) attaque D12, pas d&#39;action de mouvement pour le prochain tour pour la cible (doit etre fait 2 fois sur un quadripède ou une créature grande ou +)&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-436">
          <mxGeometry y="330" width="220" height="130" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-440" value="&lt;h1&gt;#5 dague de verre pourpre&lt;/h1&gt;&lt;p&gt;(action complexe) après avoir saisi plus en détail la nature même de la mort à travers ses victimes, le voleur est capable de créer l&#39;arme ultime pour tuer sa cible. Au prix de 5 DV, le voleur peut imprégner une dague de son envie de tuer (celle-ci devient une dague de verre pourpre, uniquement maniable par celui qui l&#39;a créé, sinon se brise au contact).&amp;nbsp;&lt;/p&gt;&lt;p&gt;dague de verre pourpre: +5 AdC, se brise si touche sa cible, les morceaux s&#39;enfonce ensuite dans le corps de la victime jusqu&#39;à son cœur, inflige 1DMG de chaos au premier tour, les dégâts double chaque tour jusqu&#39;à ce que le cœur de sa victime cesse de battre. Seule la magie d&#39;un prêtre et le savoir d&#39;un ingénieur combiné peuvent arrêter le processus). (la cible peut tout de même être soigné)&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-436">
          <mxGeometry y="530" width="220" height="410" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-441" value="&lt;h1&gt;#4 TODO&lt;/h1&gt;&lt;p&gt;embuscade?&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-436">
          <mxGeometry y="460" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-442" value="Voie du bretteur" style="swimlane;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="2940" y="8530" width="200" height="830" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-443" value="&lt;h1&gt;#3 appui solide&lt;/h1&gt;&lt;p&gt;(renforcement) +1 esquive par tour possible&lt;/p&gt;&lt;p&gt;(renforcement) pas de contrecoup d&#39;esquive si esquive réussi&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-442">
          <mxGeometry y="370" width="200" height="150" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-444" value="&lt;h1&gt;#2 TODO&lt;/h1&gt;&lt;p&gt;todo&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-442">
          <mxGeometry y="210" width="200" height="150" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-445" value="&lt;h1&gt;#5 Botte secrète&lt;/h1&gt;&lt;p&gt;TODO&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-442">
          <mxGeometry y="710" width="200" height="150" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-446" value="Voie du roublard" style="swimlane;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
