          <mxGeometry x="-507" y="2600" width="260" height="1240" as="geometry" />
        </mxCell>
        <mxCell id="jGQSzNbYtyzCzQj3RQxu-12" value="&lt;h1&gt;#1 griffes et crocs&lt;/h1&gt;&lt;p&gt;&lt;font style=&quot;font-size: 16px&quot;&gt;(passif) le draconien, doté de pattes puissante et d&#39;une grande mâchoire peut mordre ou griffer au prix d&#39;une action d&#39;attaque, 1D6 + FOR DMG&amp;nbsp;&lt;/font&gt;&lt;/p&gt;" style="text;html=1;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;glass=0;fillColor=none;" vertex="1" parent="jGQSzNbYtyzCzQj3RQxu-11">
          <mxGeometry y="20" width="260" height="170" as="geometry" />
        </mxCell>
        <mxCell id="jGQSzNbYtyzCzQj3RQxu-13" value="&lt;h1&gt;#2 cuir de dragon&lt;/h1&gt;&lt;p&gt;&lt;font style=&quot;font-size: 16px&quot;&gt;(passif) gagne +2 RD élémentaire (dans son élément ou choisi à ce rang)&amp;nbsp;&lt;/font&gt;&lt;br&gt;&lt;/p&gt;" style="text;html=1;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;glass=0;fillColor=none;" vertex="1" parent="jGQSzNbYtyzCzQj3RQxu-11">
          <mxGeometry y="193" width="260" height="130" as="geometry" />
        </mxCell>
        <mxCell id="jGQSzNbYtyzCzQj3RQxu-14" value="&lt;h1&gt;#3 coup de queue&amp;nbsp;&lt;/h1&gt;&lt;p&gt;&lt;font style=&quot;font-size: 16px&quot;&gt;(gratuit) Une fois par tour , le draconien peut effectuer un coup de queue à une cible à son contact, ce qui inflige 1D6 dégâts physique et nécessite un test de FOR difficulté 10 pour ne pas tomber&lt;/font&gt;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;glass=0;" vertex="1" parent="jGQSzNbYtyzCzQj3RQxu-11">
          <mxGeometry y="323" width="260" height="190" as="geometry" />
        </mxCell>
        <mxCell id="jGQSzNbYtyzCzQj3RQxu-15" value="&lt;h1&gt;#5 accroissement draconique&lt;/h1&gt;&lt;p&gt;&lt;font style=&quot;font-size: 16px&quot;&gt;(renforcement) amélioration du passif racial choisi:&amp;nbsp;&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;font style=&quot;font-size: 16px&quot;&gt;souffle: croissance des cornes, le souffle inflige désormais 2D6 DMG et gagne un effet :&lt;/font&gt;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;feu: brulure 1D6 DM pendant 1d6 tours (ne se cumule pas)&lt;/li&gt;&lt;li&gt;glace: ralenti la cible et la limite à une action par tour (attaque ou mouvement) pendant 1d6 tours&lt;/li&gt;&lt;li&gt;foudre: réduit la mana de la cible de DMG / 2&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;font-size: 16px&quot;&gt;ailes: plus grandes ailes (ne sont plus abîmés), plus de limite de durée de vol, peut maintenant porter une créature de taille moyenne pendant FOR tours, peut maintenant se battre dans les airs&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 16px&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;p&gt;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;glass=0;" vertex="1" parent="jGQSzNbYtyzCzQj3RQxu-11">
          <mxGeometry y="713" width="260" height="520" as="geometry" />
        </mxCell>
        <mxCell id="jGQSzNbYtyzCzQj3RQxu-16" value="&lt;h1&gt;#4 libération&lt;/h1&gt;&lt;p&gt;&lt;span style=&quot;font-size: 16px&quot;&gt;(passif) Le draconien n&#39;a plus l&#39;impression de subir les malheurs de ses ancêtres et se sens plus en forme. +2 CHAN (annule le malus de stat) et le bonus de RD élémentaire du cuir de dragon passe à +4&lt;/span&gt;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;glass=0;" vertex="1" parent="jGQSzNbYtyzCzQj3RQxu-11">
          <mxGeometry y="513" width="260" height="200" as="geometry" />
        </mxCell>
        <mxCell id="jGQSzNbYtyzCzQj3RQxu-17" value="&lt;h1&gt;&amp;nbsp; Bonus de stat&lt;/h1&gt;&lt;p&gt;&lt;font style=&quot;font-size: 16px&quot;&gt;+2 CON, -2 DEX, -2 CHAN&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;/p&gt;" style="text;html=1;strokeColor=#82b366;fillColor=#FFFFFF;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=1;shadow=1;" vertex="1" parent="Fy31WUsdD2yVTO4LC-Jr-1">
          <mxGeometry x="-1034.5" y="3260" width="225" height="115" as="geometry" />
        </mxCell>
        <mxCell id="jGQSzNbYtyzCzQj3RQxu-18" value="&lt;h1&gt;&amp;nbsp; &amp;nbsp;passif racial&amp;nbsp;&lt;/h1&gt;&lt;p style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;Grand pas&lt;/b&gt;: pas de malus de déplacement / pas de jet en terrain naturelle difficile (forêts dense, collines abrupte, traversées d&#39;une rivières)&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;/p&gt;" style="text;html=1;strokeColor=#6c8ebf;fillColor=#FFFFFF;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=1;glass=0;shadow=1;" vertex="1" parent="Fy31WUsdD2yVTO4LC-Jr-1">
          <mxGeometry x="350" y="3037" width="270" height="150" as="geometry" />
        </mxCell>
        <mxCell id="jGQSzNbYtyzCzQj3RQxu-19" value="&lt;h1&gt;&lt;span&gt;dé de vie:&amp;nbsp; 6&lt;/span&gt;&lt;/h1&gt;&lt;div&gt;&lt;b&gt;&lt;font style=&quot;font-size: 24px&quot;&gt;dé de mana: 6&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;" style="text;html=1;strokeColor=#b85450;fillColor=#FFFFFF;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=1;shadow=1;" vertex="1" parent="Fy31WUsdD2yVTO4LC-Jr-1">
          <mxGeometry x="390" y="2867" width="190" height="90" as="geometry" />
        </mxCell>
        <mxCell id="jGQSzNbYtyzCzQj3RQxu-20" value="Voie du elfe-sylvain" style="swimlane;" vertex="1" parent="Fy31WUsdD2yVTO4LC-Jr-1">
          <mxGeometry x="900" y="2737" width="200" height="910" as="geometry" />
        </mxCell>
        <mxCell id="ltSEl78esRlXe0Swhk5b-0" value="&lt;h1&gt;#4 équipement naturel&lt;/h1&gt;&lt;p&gt;(passif) ajoute 1d6 à ses armes et +2 classe d&#39;armure à ses armures qui ne contiennent pas de métal&lt;/p&gt;&lt;p&gt;(passif) n&#39;a plus de malus de DEX lié à son armure si celle-ci n&#39;est pas métallique&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="jGQSzNbYtyzCzQj3RQxu-20">
          <mxGeometry y="533" width="200" height="180" as="geometry" />
        </mxCell>
        <mxCell id="Z-8uaik6AfoaBDK6E7K7-0" value="&lt;h1&gt;#5 harmonie avec la nature&lt;/h1&gt;&lt;p&gt;(passif) +2 DEX et +2 CON&lt;/p&gt;&lt;p&gt;(renforcement) amis de la foret, avantage sur le jet&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="jGQSzNbYtyzCzQj3RQxu-20">
          <mxGeometry y="713" width="200" height="207" as="geometry" />
        </mxCell>
        <mxCell id="jGQSzNbYtyzCzQj3RQxu-21" value="&lt;h1&gt;&amp;nbsp; Bonus de stat&lt;/h1&gt;&lt;p&gt;&lt;font style=&quot;font-size: 16px&quot;&gt;+1 DEX, -1 FOR, -2 SOC&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;/p&gt;" style="text;html=1;strokeColor=#82b366;fillColor=#FFFFFF;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=1;shadow=1;" vertex="1" parent="Fy31WUsdD2yVTO4LC-Jr-1">
          <mxGeometry x="385" y="3247" width="200" height="115" as="geometry" />
        </mxCell>
        <mxCell id="jGQSzNbYtyzCzQj3RQxu-22" value="&lt;h1&gt;&amp;nbsp; &amp;nbsp;passif racial&amp;nbsp;&lt;/h1&gt;&lt;p style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;vision elfique&amp;nbsp;&lt;/b&gt;:&amp;nbsp;&lt;span&gt;voit dans le noir et +1 pour tous ses jets dans les forêts, bosquets, chez les siens&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;font-size: 16px&quot;&gt;-1 pour tous ses jets sous terre, dans des grottes ou montagnes, ou chez les nains&lt;/p&gt;&lt;br&gt;&lt;p&gt;&lt;/p&gt;&lt;p&gt;&lt;/p&gt;" style="text;html=1;strokeColor=#6c8ebf;fillColor=#FFFFFF;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=1;glass=0;shadow=1;" vertex="1" parent="Fy31WUsdD2yVTO4LC-Jr-1">
