        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-211" value="&lt;h1&gt;#1 entrainement à la parade&lt;/h1&gt;&lt;p&gt;&lt;font style=&quot;font-size: 14px&quot;&gt;(passif) entrainé aux duels et aux combats, gagne +1 DEF CaC / rang&amp;nbsp; &lt;b&gt;OU&lt;/b&gt;&amp;nbsp;+1 DEF DIST / rang&lt;/font&gt;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;glass=0;sketch=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-210">
          <mxGeometry y="30" width="200" height="170" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-212" value="&lt;h1&gt;#3 feinte&lt;/h1&gt;&lt;p&gt;(action complexe) --&amp;gt; attaque normale, prochain tour, attaque normal --&amp;gt; +5 attaque et +2D6 DMG&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;glass=0;sketch=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-210">
          <mxGeometry y="300" width="200" height="120" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-213" value="&lt;h1&gt;#4 dehors les importuns !&lt;/h1&gt;&lt;p&gt;(passif) contre des groupes d&#39;ennemis de tailles petites , minuscules ou dont leur niveau est inférieur à la moitié de celui du chevalier, gagne +2D6 DMG contre eux et +5 DEF&lt;/p&gt;&lt;p&gt;(renforcement) ouverture --&amp;gt; +4&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;glass=0;sketch=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-210">
          <mxGeometry y="430" width="200" height="200" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-214" value="&lt;h1&gt;#5 duelliste&lt;/h1&gt;&lt;p&gt;(passif) en 1 contre 1 clairement identifié, le chevalier gagne +3 DEF CaC, +3 DEF DIST, +3 AdC, +1d6 DMG pour ses attaques au CaC&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;glass=0;sketch=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-210">
          <mxGeometry y="630" width="200" height="120" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-215" value="&lt;h1&gt;#2 ouverture&lt;/h1&gt;&lt;p&gt;(passif) donne un bonus de +2 en attaque pour toucher une cible en armure&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;glass=0;sketch=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-210">
          <mxGeometry y="190" width="200" height="120" as="geometry" />
        </mxCell>
