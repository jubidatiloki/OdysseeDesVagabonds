        <mxCell id="NVimz5JA0NgIxIB_Wmtv-185" value="Voie du vagabond" style="swimlane;startSize=23;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="2390" y="-530" width="200" height="770" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-186" value="&lt;h1&gt;#2 légendes et rumeurs&lt;/h1&gt;&lt;p&gt;(passif) +2 / rangs aux tests d&#39;INT liés à la connaissance d&#39;une rumeur qu&#39;il aurait pu entendre dans une taverne et sur le marché ou de légendes anciennes&lt;br&gt;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-185">
          <mxGeometry y="130" width="200" height="160" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-187" value="&lt;h1&gt;#1 grand pas&lt;/h1&gt;&lt;p&gt;(passif) +5 test de CON liés à la marche et la course&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-185">
          <mxGeometry y="30" width="200" height="120" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-188" value="&lt;h1&gt;#3 grandes poches&lt;/h1&gt;&lt;p&gt;(soutien) dispose d&#39;un sac très bien adapté aux voyages, il gagne ainsi virtuellement 10 de FOR pour le calcul du poids&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-185">
          <mxGeometry y="290" width="200" height="160" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-189" value="&lt;h1&gt;#4 diversité culturelle&lt;/h1&gt;&lt;p&gt;peut prendre une compétence de rang 3 d&#39;une autre classe&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-185">
          <mxGeometry y="460" width="200" height="160" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-190" value="&lt;h1&gt;#5 vagabond&lt;/h1&gt;&lt;p&gt;(passif) +1 dans chaque stats (voyager ca fait grandir)&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-185">
          <mxGeometry y="610" width="200" height="160" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-191" value="Voie du musicien" style="swimlane;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
          <mxGeometry x="2640" y="-530" width="200" height="900" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-193" value="&lt;h1&gt;#1 début artistique&lt;/h1&gt;&lt;p&gt;(soutien) dispose d&#39;un instrument (lyre, flute, oud, banjo, ...) +2/rang aux tests liés au fait de bien joué de cette instrument&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-191">
          <mxGeometry y="30" width="200" height="160" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-194" value="&lt;h1&gt;#3 musicien en herbe&lt;/h1&gt;&lt;p&gt;(soutien)peut se faire payer 1d20 + CHAN pièces de cuivre (sur un marché ou une place) ou se faire payer le repas et une chambre dans une auberge&amp;nbsp; en jouant de son instrument (test difficulté 10 minimum, sinon échec)&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-191">
          <mxGeometry y="340" width="200" height="180" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-195" value="&lt;h1&gt;#4 artiste&lt;/h1&gt;&lt;p&gt;(sort cout rang 1) petits sorts d&#39;illusion, de flammèches ou autres (inefficaces en combat) mais peut impressionner/ distraire, test d&#39;INT diff 14 pour ne pas être impressionné/distrait&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-191">
          <mxGeometry y="530" width="200" height="160" as="geometry" />
        </mxCell>
        <mxCell id="NVimz5JA0NgIxIB_Wmtv-196" value="&lt;h1&gt;#2 musique vivifiante&lt;/h1&gt;&lt;p&gt;(actif complexe) en combat, joue de son instrument, donne +2 aux jets d&#39;attaque de ses alliés à portée d&#39;écoute jusqu&#39;à la fin du combat&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-191">
          <mxGeometry y="180" width="200" height="160" as="geometry" />
        </mxCell>
