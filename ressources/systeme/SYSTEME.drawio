        <mxCell id="jGQSzNbYtyzCzQj3RQxu-2" value="&lt;h1&gt;&lt;span&gt;dé de vie:&amp;nbsp; 6&lt;/span&gt;&lt;/h1&gt;&lt;div&gt;&lt;b&gt;&lt;font style=&quot;font-size: 24px&quot;&gt;dé de mana: 6&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;" style="text;html=1;strokeColor=#b85450;fillColor=#FFFFFF;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=1;shadow=1;" vertex="1" parent="Fy31WUsdD2yVTO4LC-Jr-1">
