        <mxCell id="NVimz5JA0NgIxIB_Wmtv-205" value="&lt;h1&gt;#1 Cheval de guerre&lt;/h1&gt;&lt;p&gt;(soutien) dispose d&#39;un cheval de bataille et d&#39;une lance, De plus, le chevalier sait désormais monter à cheval (aptitude équitation gratuite)&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;glass=0;sketch=0;" vertex="1" parent="NVimz5JA0NgIxIB_Wmtv-204">
