        <mxCell id="jGQSzNbYtyzCzQj3RQxu-32" value="Voie du nain" style="swimlane;fillColor=#FFFFFF;" vertex="1" parent="Fy31WUsdD2yVTO4LC-Jr-1">
          <mxGeometry x="940" y="5882.5" width="220" height="785" as="geometry" />
        </mxCell>
        <mxCell id="jGQSzNbYtyzCzQj3RQxu-33" value="&lt;h1&gt;#1 Outils de nain&lt;/h1&gt;&lt;p&gt;&lt;font style=&quot;font-size: 14px&quot;&gt;(passif)Maitrise de la hache et du marteau, si c&#39;était déjà le cas, donne +1 AdC et +1 DMG avec ces armes à la place&lt;/font&gt;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="jGQSzNbYtyzCzQj3RQxu-32">
          <mxGeometry y="27.5" width="220" height="145" as="geometry" />
        </mxCell>
        <mxCell id="jGQSzNbYtyzCzQj3RQxu-34" value="&lt;h1&gt;#2 Ivresse naine&lt;/h1&gt;&lt;p&gt;&lt;font style=&quot;font-size: 14px&quot;&gt;(passif) Suite à leur style de vie arrosé, bonus de +5 au tests de CON et peut refaire un jet en cas d&#39;échec (hors échec critique) à un test de CON liés aux breuvages (poison compris)&lt;/font&gt;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="jGQSzNbYtyzCzQj3RQxu-32">
          <mxGeometry y="172.5" width="220" height="167.5" as="geometry" />
        </mxCell>
        <mxCell id="jGQSzNbYtyzCzQj3RQxu-35" value="&lt;h1&gt;#3 Tête de fer&lt;/h1&gt;&lt;p&gt;&lt;font style=&quot;font-size: 14px&quot;&gt;(gratuit) donne une attaque gratuite de coup de tête une fois par tour, 1D6 + CON DMG&lt;/font&gt;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="jGQSzNbYtyzCzQj3RQxu-32">
          <mxGeometry y="340" width="220" height="120" as="geometry" />
        </mxCell>
        <mxCell id="jGQSzNbYtyzCzQj3RQxu-36" value="&lt;h1&gt;#5 Ténacité&lt;/h1&gt;&lt;p&gt;(passif) +2 CON, +2 RD physique, +2 RD magique, +2 RD dans un élément (élément au choix)&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="jGQSzNbYtyzCzQj3RQxu-32">
          <mxGeometry y="670" width="220" height="120" as="geometry" />
        </mxCell>
        <mxCell id="jGQSzNbYtyzCzQj3RQxu-37" value="&lt;h1&gt;#4 acolyte des montagnes&lt;/h1&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px&quot;&gt;(soutien) dompte un bouquetin pouvant lui servir de monture (pas de compétence particulier pour le combat et panique si n&#39;a pas la voie du cavalier de chevalier), mais a un bonus de +10 d&#39;escalade avec celui-ci et galope à la même vitesse qu&#39;un cheval&lt;/span&gt;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="jGQSzNbYtyzCzQj3RQxu-32">
          <mxGeometry y="445" width="220" height="225" as="geometry" />
        </mxCell>
        <mxCell id="jGQSzNbYtyzCzQj3RQxu-38" value="&lt;h1&gt;&amp;nbsp; Bonus de stat&lt;/h1&gt;&lt;p&gt;&lt;font style=&quot;font-size: 16px&quot;&gt;+2 CON, -2 DEX&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;/p&gt;" style="text;html=1;strokeColor=#82b366;fillColor=#FFFFFF;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=1;shadow=1;" vertex="1" parent="Fy31WUsdD2yVTO4LC-Jr-1">
          <mxGeometry x="397.5" y="6460" width="200" height="115" as="geometry" />
        </mxCell>
        <mxCell id="jGQSzNbYtyzCzQj3RQxu-48" value="&lt;h1&gt;&amp;nbsp; &amp;nbsp;passif racial&amp;nbsp;&lt;/h1&gt;&lt;p style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;richesse culturelle&lt;/b&gt;: de part sa polyvalence, il démarre avec 1pt de compétence en plus&lt;/p&gt;&lt;br&gt;&lt;p&gt;&lt;/p&gt;" style="text;html=1;strokeColor=#6c8ebf;fillColor=#FFFFFF;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=1;glass=0;shadow=1;" vertex="1" parent="Fy31WUsdD2yVTO4LC-Jr-1">
          <mxGeometry x="-1080" y="6120" width="270" height="140" as="geometry" />
        </mxCell>
        <mxCell id="jGQSzNbYtyzCzQj3RQxu-49" value="&lt;h1&gt;&lt;span&gt;dé de vie:&amp;nbsp; 6&lt;/span&gt;&lt;/h1&gt;&lt;div&gt;&lt;b&gt;&lt;font style=&quot;font-size: 24px&quot;&gt;dé de mana: 6&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;" style="text;html=1;strokeColor=#b85450;fillColor=#FFFFFF;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=1;shadow=1;" vertex="1" parent="Fy31WUsdD2yVTO4LC-Jr-1">
          <mxGeometry x="-1075" y="5950" width="190" height="90" as="geometry" />
        </mxCell>
        <mxCell id="jGQSzNbYtyzCzQj3RQxu-50" value="Voie d&#39;humain" style="swimlane;fillColor=#FFFFFF;" vertex="1" parent="Fy31WUsdD2yVTO4LC-Jr-1">
          <mxGeometry x="-510" y="5820" width="210" height="876" as="geometry" />
        </mxCell>
        <mxCell id="jGQSzNbYtyzCzQj3RQxu-51" value="&lt;h1&gt;#5 perfectionnement&lt;/h1&gt;&lt;p&gt;+2 dans la plus faible stat et dans &lt;b&gt;une autre&lt;/b&gt; au choix&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;" vertex="1" parent="jGQSzNbYtyzCzQj3RQxu-50">
          <mxGeometry y="755" width="210" height="120" as="geometry" />
        </mxCell>
        <mxCell id="jGQSzNbYtyzCzQj3RQxu-52" value="&lt;h1&gt;#3 charme&lt;/h1&gt;&lt;p&gt;(passif) +5 aux tests de SOC et MEN contre les cibles du sexe opposé (ou non, selon les affinités de l&#39;humain ...)&lt;br&gt;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="jGQSzNbYtyzCzQj3RQxu-50">
          <mxGeometry y="545" width="210" height="110" as="geometry" />
        </mxCell>
        <mxCell id="jGQSzNbYtyzCzQj3RQxu-53" value="&lt;h1&gt;#2 Origines marquées&lt;/h1&gt;&lt;p&gt;Selon origine :&lt;/p&gt;&lt;p&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Campagnard: +5 aux tests de SOC dans les campagnes et les villages&lt;/li&gt;&lt;li&gt;Orfèvre: connaissance de géologie gratuite, +5 aux tests permettant d&#39;identifier un métal ou une pierre précieuse&lt;/li&gt;&lt;li&gt;Marin: connaissance natation et cartographie, +5 aux tests liés à la navigation&lt;/li&gt;&lt;li&gt;Erudit:&amp;nbsp; +5 aux tests d&#39;INT liés à une connaissance au choix&lt;/li&gt;&lt;li&gt;Garde: +5 aux tests de CON lié à la fatigue&lt;/li&gt;&lt;li&gt;Marchand: +5 en SOC pour négocier avec d&#39;autres marchands&amp;nbsp;&lt;/li&gt;&lt;li&gt;Troubadour: maitrise d&#39;un instrument, sait le jouer, mais n&#39;a pas de bonus si n&#39;a pas la voie du musicien du barde)&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="jGQSzNbYtyzCzQj3RQxu-50">
          <mxGeometry y="125" width="210" height="420" as="geometry" />
        </mxCell>
        <mxCell id="jGQSzNbYtyzCzQj3RQxu-54" value="&lt;h1&gt;#4 polyvalence&lt;/h1&gt;&lt;p&gt;(passif) gagne 2 rangs 1 ou 2 d&#39;une autre classe&amp;nbsp;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="jGQSzNbYtyzCzQj3RQxu-50">
          <mxGeometry y="655" width="210" height="100" as="geometry" />
        </mxCell>
        <mxCell id="jGQSzNbYtyzCzQj3RQxu-55" value="&lt;h1&gt;#1 Polyglotte&lt;/h1&gt;&lt;p&gt;(passif) l&#39;humain peut parler 2 langues en plus du commun&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="jGQSzNbYtyzCzQj3RQxu-50">
          <mxGeometry y="25" width="210" height="100" as="geometry" />
        </mxCell>
        <mxCell id="jGQSzNbYtyzCzQj3RQxu-56" value="&lt;h1&gt;&amp;nbsp; Bonus de stat&lt;/h1&gt;&lt;p style=&quot;font-size: 16px&quot;&gt;&lt;font style=&quot;font-size: 16px&quot;&gt;Selon origine (issu d&#39;une famille ou a travaillé il y a quelques années) :&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;font-size: 16px&quot;&gt;&lt;/p&gt;&lt;ul style=&quot;font-size: 16px&quot;&gt;&lt;li&gt;&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;Campagnard&lt;/b&gt;: +2 FOR, -2 INT&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;Orfèvre&lt;/b&gt;: +2 DEX, -2 SOC&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;Marin&lt;/b&gt;: +2 CON, -2 INT&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;Érudit&lt;/b&gt;: +2 INT, -1 FOR, -1 SOC&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;Garde&lt;/b&gt;: +2 PER, -2 DEX&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;Marchand&lt;/b&gt;: +2 SOC, -2 CON&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;Troubadour&lt;/b&gt;: +2 CHAR, - 2 FOR&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;/p&gt;&lt;p&gt;&lt;/p&gt;" style="text;html=1;strokeColor=#82b366;fillColor=#FFFFFF;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=1;shadow=1;" vertex="1" parent="Fy31WUsdD2yVTO4LC-Jr-1">
          <mxGeometry x="-1080" y="6305" width="310" height="255" as="geometry" />
        </mxCell>
        <mxCell id="jbU_k0vdc1HRgwljLxtI-0" value="&lt;h1&gt;#1 Accessoire vraisemblablement indispensable&lt;/h1&gt;&lt;p&gt;&lt;font style=&quot;font-size: 14px&quot;&gt;(passif)Maitrise d&#39;une arme ou d&#39;un instrument de musique au choix, si choix d&#39;une arme/instrument déjà maitrisé, donne +1 AdC/+1AdT et +1 DMG avec cette arme à la place (si instrument déja maitrisé, +2 pour un instrument)&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font style=&quot;font-size: 14px&quot;&gt;(soutien) possède un porte bonheur (petit objet) qui lui donne +1 CHAN tant qu&#39;il l&#39;a sur lui&lt;/font&gt;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="Fy31WUsdD2yVTO4LC-Jr-1">
          <mxGeometry x="940" y="4330" width="250" height="310" as="geometry" />
        </mxCell>
        <mxCell id="jbU_k0vdc1HRgwljLxtI-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=30;fontColor=#000000;" edge="1" parent="Fy31WUsdD2yVTO4LC-Jr-1" source="jbU_k0vdc1HRgwljLxtI-1" target="2Pnyq9TWK4HK2MC00WFC-0">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="jbU_k0vdc1HRgwljLxtI-3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=30;fontColor=#000000;" edge="1" parent="Fy31WUsdD2yVTO4LC-Jr-1" source="jbU_k0vdc1HRgwljLxtI-1" target="x2D-LWfeukSzoIRtPwrQ-3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="jbU_k0vdc1HRgwljLxtI-1" value="&lt;h1&gt;pas présent dans la V1.0.0&lt;/h1&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;labelBackgroundColor=none;fontSize=30;fontColor=#000000;" vertex="1" parent="Fy31WUsdD2yVTO4LC-Jr-1">
          <mxGeometry x="-203" y="700" width="650" height="220" as="geometry" />
        </mxCell>
        <mxCell id="jbU_k0vdc1HRgwljLxtI-4" value="&lt;h1&gt;#2 Discussion insensée mais soit disant pertinente&lt;/h1&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px&quot;&gt;(actif) (compétence) une fois par combat, si la cible du gnome est humanoïde et comprend sa langue, le gnome peut raconter sa vie au milieu du combat afin de perturber sa cible, test de SOC du gnome en opposition à un test de MEN de la cible. Si réussite, -3 dans toutes les DEF de la cible jusqu&#39;au prochain tour + perte de son action d&#39;attaque pour ce tour si elle joue après le gnome&lt;/span&gt;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="Fy31WUsdD2yVTO4LC-Jr-1">
          <mxGeometry x="940" y="4640" width="250" height="300" as="geometry" />
        </mxCell>
