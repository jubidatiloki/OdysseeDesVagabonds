        <mxCell id="VE-AA93kvBegw-qPm-UM-0" value="&lt;h1&gt;#2 Soin modéré&lt;/h1&gt;&lt;p&gt;(actif)(sort) soigne une cible jusqu&#39;à [RANG] x 10m de 2D6 PV&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;shadow=1;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
