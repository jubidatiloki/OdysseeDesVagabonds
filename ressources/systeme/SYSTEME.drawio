        <mxCell id="hcIEUVegiNGtS17RQzHk-0" value="&lt;h1&gt;#3 Dans ma sacoche, j&#39;ai ...&lt;/h1&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;(soutien) retrouve, trouve, achète (à avoir avec le MJ) une petite sacoche qui peut contenir jusqu&#39;à 50kg d&#39;objets en tout genre (non vivant uniquement, la nourriture ne se conserve pas mieux qu&#39;en dehors) (le sac ne pèse&amp;nbsp;rien pour le gnome)&lt;/span&gt;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="Fy31WUsdD2yVTO4LC-Jr-1">
          <mxGeometry x="940" y="4940" width="250" height="200" as="geometry" />
        </mxCell>
        <mxCell id="z7E9WVfDCVmPTDCwJRAH-0" value="&lt;h1&gt;#1 sagesse ancestrale&lt;/h1&gt;&lt;p&gt;(passif) +5 aux tests liés aux connaissances sur les différentes races du continents et sur des évènements historiques passés&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="Fy31WUsdD2yVTO4LC-Jr-1">
          <mxGeometry x="-560" y="4383" width="200" height="147" as="geometry" />
        </mxCell>
        <mxCell id="z7E9WVfDCVmPTDCwJRAH-1" value="&lt;h1&gt;#2 affinité magique&lt;/h1&gt;&lt;div&gt;(passif) +5 SOC pour parler une créature magique et +5 INT pour comprendre une créature magique&lt;/div&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="Fy31WUsdD2yVTO4LC-Jr-1">
          <mxGeometry x="-560" y="4529" width="200" height="147" as="geometry" />
        </mxCell>
        <mxCell id="z7E9WVfDCVmPTDCwJRAH-2" value="&lt;h1&gt;&amp;nbsp; Maitrises&lt;/h1&gt;&lt;p style=&quot;font-size: 16px&quot;&gt;&lt;font style=&quot;font-size: 16px&quot;&gt;- armes 1 mains communes&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;/p&gt;" style="text;html=1;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=1;shadow=1;fillColor=default;" vertex="1" parent="Fy31WUsdD2yVTO4LC-Jr-1">
          <mxGeometry x="365" y="4855" width="225" height="115" as="geometry" />
        </mxCell>
        <mxCell id="z7E9WVfDCVmPTDCwJRAH-3" value="&lt;h1 style=&quot;text-align: center;&quot;&gt;&amp;nbsp; Restrictions &amp;amp;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;particularités&lt;/h1&gt;&lt;p style=&quot;font-size: 16px&quot;&gt;&lt;font style=&quot;font-size: 16px&quot;&gt;- pas d&#39;armes dépassant le d8 (armes à 2d6 autorisés par exemple)&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;font-size: 16px&quot;&gt;&lt;font style=&quot;font-size: 16px&quot;&gt;- pas d&#39;armure dépassant la côte de maille (armure de plaque adapté à la corpulence du gnome possible cependant)&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;font-size: 16px&quot;&gt;&lt;font style=&quot;font-size: 16px&quot;&gt;- armures moins cher à faire&amp;nbsp; (vu la corpulence du gnome)&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;/p&gt;" style="text;html=1;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=1;shadow=1;fillColor=default;" vertex="1" parent="Fy31WUsdD2yVTO4LC-Jr-1">
