        <mxCell id="a2TnysspR21SorLo6oqh-1" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 20px; background-color: initial;&quot;&gt;Les rangs de voie raciale sont débloqués gratuitement tous les niveaux impairs.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fillColor=#ffe6cc;shadow=1;strokeColor=#d79b00;" vertex="1" parent="1">
