        <mxCell id="PuKH8ddpfEu2_1Ormtuv-0" parent="sPp2nEJlRjR283OlNyq3-0" style="text;html=1;strokeColor=#000000;fillColor=#e1d5e7;spacing=15;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=1;shadow=1;labelBackgroundColor=none;fontSize=20;strokeWidth=2;" value="&lt;h1 style=&quot;text-align: center; font-size: 20px;&quot;&gt;Aptitude magique (AM)&lt;/h1&gt;&lt;h1 style=&quot;font-size: 20px;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-family: arial; font-weight: normal;&quot;&gt;Maitrise des lancers de sort et de la magie en général, importante pour les &lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-family: arial;&quot;&gt;druides&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-family: arial; font-weight: normal;&quot;&gt;, &lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-family: arial;&quot;&gt;magiciens&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-family: arial;&quot;&gt;&lt;span style=&quot;font-weight: normal;&quot;&gt;et &lt;/span&gt;nécromanciens&lt;/span&gt;&lt;/h1&gt;&lt;h1 style=&quot;font-size: 20px;&quot;&gt;&lt;ul&gt;&lt;li style=&quot;&quot;&gt;&lt;span style=&quot;font-weight: 400;&quot;&gt;permet d&#39;augmenter les chances de toucher avec les sorts (toucher bonus = AM)&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-weight: 400;&quot;&gt;permet d&#39;augmenter l&#39;esquive magique (esquive bonus = AM / 2, arrondi au supérieur)&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/h1&gt;" vertex="1">
