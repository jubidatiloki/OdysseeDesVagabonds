        <mxCell id="2rxSsDhHAnS-eIEXSBTq-0" value="&lt;h1&gt;#1 dépeçage&lt;/h1&gt;&lt;p&gt;(renforcement) +2 / RANG pour dépecer correctement la peau, la viande d&#39;un animal (et éventuellement le vendre sur un marché)&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="HfUVAWYtu06yr5lZbogK-1">
