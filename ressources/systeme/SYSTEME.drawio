        <mxCell id="1E0pnR5yacwigoUuw52S-16" parent="sPp2nEJlRjR283OlNyq3-2" style="text;html=1;strokeColor=#000000;fillColor=#dae8fc;spacing=15;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=1;shadow=1;labelBackgroundColor=none;fontSize=20;strokeWidth=2;" value="&lt;h1 style=&quot;text-align: center; font-size: 20px;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Esquive (ESQ)&lt;/font&gt;&lt;/h1&gt;&lt;div style=&quot;font-size: 20px;&quot;&gt;&lt;span id=&quot;docs-internal-guid-db25115c-7fff-44c1-7c6c-5ecae0a2eccb&quot; style=&quot;font-size: 20px;&quot;&gt;&lt;span style=&quot;font-family: arial; background-color: transparent; vertical-align: baseline; font-size: 20px;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Représente la capacité à pouvoir esquiver une attaque, plutôt que l’encaisser&lt;/font&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;&lt;br style=&quot;font-size: 20px;&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 20px;&quot;&gt;&lt;ul style=&quot;font-size: 20px;&quot;&gt;&lt;li dir=&quot;ltr&quot; style=&quot;list-style-type: disc; font-family: arial; background-color: transparent; vertical-align: baseline; font-size: 20px;&quot;&gt;&lt;p dir=&quot;ltr&quot; style=&quot;line-height: 1.38; margin-top: 0pt; margin-bottom: 0pt; font-size: 20px;&quot;&gt;&lt;span style=&quot;background-color: transparent; vertical-align: baseline; font-size: 20px;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;retire l’action de mouvement du prochain tour (peu importe le résultat du test)&lt;/font&gt;&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;li dir=&quot;ltr&quot; style=&quot;list-style-type: disc; font-family: arial; background-color: transparent; vertical-align: baseline; font-size: 20px;&quot;&gt;&lt;p dir=&quot;ltr&quot; style=&quot;line-height: 1.38; margin-top: 0pt; margin-bottom: 0pt; font-size: 20px;&quot;&gt;&lt;span style=&quot;background-color: transparent; vertical-align: baseline; font-size: 20px;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;1 esquive par tour max&lt;/font&gt;&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;li dir=&quot;ltr&quot; style=&quot;list-style-type: disc; font-family: arial; background-color: transparent; vertical-align: baseline; font-size: 20px;&quot;&gt;&lt;p dir=&quot;ltr&quot; style=&quot;line-height: 1.38; margin-top: 0pt; margin-bottom: 0pt; font-size: 20px;&quot;&gt;&lt;span style=&quot;background-color: transparent; vertical-align: baseline; font-size: 20px;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b style=&quot;font-size: 20px;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;calcul esquive&lt;/font&gt;&lt;/b&gt; = 10 + DEX/2 + compétences + équipement (bonus et malus d’armure) + autres&lt;/font&gt;&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;h1 style=&quot;font-size: 20px;&quot;&gt;&lt;br style=&quot;font-size: 20px;&quot;&gt;&lt;/h1&gt;" vertex="1">
