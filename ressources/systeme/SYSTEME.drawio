        <mxCell id="vBfNNVceucOeTJYV6Jtg-2" value="&lt;h1 style=&quot;text-align: center&quot;&gt;Désavantage&lt;/h1&gt;&lt;div style=&quot;text-align: center;&quot;&gt;Avoir un désavantage sur un jet signifie que&lt;b&gt; 2 dés&lt;/b&gt; sont lancé et que l&#39;on prend en compte le &lt;b&gt;plus mauvais&amp;nbsp;&lt;/b&gt;résultat&lt;/div&gt;" style="text;html=1;fillColor=#d5e8d4;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=1;shadow=1;strokeColor=#82b366;" vertex="1" parent="1">
